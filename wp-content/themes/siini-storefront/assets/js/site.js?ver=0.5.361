(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var scrollers = Array.prototype.slice.call(document.querySelectorAll('[data-siini-new-scroller]'));
		var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		function syncHomepageTickerSpeed() {
			var topTrack = document.querySelector('.siini-top-ticker__track');
			var brandTrack = document.querySelector('.siini-demo-brandline__track');
			var brandDuration;
			var brandLoopWidth;
			var topLoopWidth;
			var topDuration;

			if (prefersReducedMotion || !topTrack || !brandTrack) {
				return;
			}

			brandDuration = parseFloat(window.getComputedStyle(brandTrack).animationDuration) * 1000;
			brandLoopWidth = brandTrack.scrollWidth / 2;
			topLoopWidth = topTrack.scrollWidth / 2;

			if (!brandDuration || !brandLoopWidth || !topLoopWidth) {
				return;
			}

			topDuration = brandDuration * (topLoopWidth / brandLoopWidth);
			topTrack.style.setProperty('animation-duration', topDuration + 'ms', 'important');
		}

		if (!prefersReducedMotion) {
			window.requestAnimationFrame(syncHomepageTickerSpeed);
			window.addEventListener('resize', syncHomepageTickerSpeed);

			if (document.fonts && document.fonts.ready) {
				document.fonts.ready.then(syncHomepageTickerSpeed);
			}
		}

		scrollers.forEach(function (scroller) {
			var originalCards = Array.prototype.slice.call(scroller.querySelectorAll('[data-siini-new-card]'));
			var cards = originalCards;
			var section = scroller.closest('[data-siini-home-new]');
			var prevButton = section ? section.querySelector('[data-siini-new-prev]') : null;
			var nextButton = section ? section.querySelector('[data-siini-new-next]') : null;
			var carousel = scroller.closest('.siini-home-new-carousel');
			var originalCount = originalCards.length;
			var firstOriginalIndex = originalCount;
			var lastOriginalIndex = (originalCount * 2) - 1;
			var frame = 0;
			var currentIndex = firstOriginalIndex;
			var dragStartX = 0;
			var dragStartScrollLeft = 0;
			var dragLastTime = 0;
			var dragLastScrollLeft = 0;
			var dragVelocity = 0;
			var dragPointerId = null;
			var hasPointerCapture = false;
			var isDragging = false;
			var isMomentumScrolling = false;
			var isProgrammaticScroll = false;
			var didDrag = false;
			var snapTimer = 0;
			var programmaticTimer = 0;
			var momentumFrame = 0;
			var suppressClickUntil = 0;
			var dragSensitivity = 1;
			var wheelSensitivity = 0.58;

			function setupLoop() {
				var beforeFragment;
				var afterFragment;

				if (originalCount < 2 || scroller.getAttribute('data-siini-new-loop-ready') === 'true') {
					return;
				}

				beforeFragment = document.createDocumentFragment();
				afterFragment = document.createDocumentFragment();

				originalCards.forEach(function (card) {
					var beforeClone = card.cloneNode(true);
					var afterClone = card.cloneNode(true);

					beforeClone.setAttribute('data-siini-new-clone', 'before');
					afterClone.setAttribute('data-siini-new-clone', 'after');
					beforeFragment.appendChild(beforeClone);
					afterFragment.appendChild(afterClone);
				});

				scroller.insertBefore(beforeFragment, originalCards[0]);
				scroller.appendChild(afterFragment);
				scroller.setAttribute('data-siini-new-loop-ready', 'true');
				cards = Array.prototype.slice.call(scroller.querySelectorAll('[data-siini-new-card]'));
			}

			function gapSize() {
				var styles = window.getComputedStyle ? window.getComputedStyle(scroller) : null;
				var rawGap = styles ? (styles.columnGap || styles.gap || '0') : '0';

				return parseFloat(rawGap) || 0;
			}

			function layoutInfo() {
				var firstCard = cards[0];
				var gap = gapSize();
				var viewportWidth = scroller.clientWidth;
				var cardWidth = firstCard ? firstCard.getBoundingClientRect().width : 0;
				var fullCards = cardWidth ? Math.max(1, Math.floor((viewportWidth + gap) / (cardWidth + gap))) : 1;
				var sidePeek = Math.max(0, (viewportWidth - (fullCards * cardWidth) - ((fullCards + 1) * gap)) / 2);

				scroller.style.setProperty('--siini-new-snap-padding', Math.max(0, Math.round(gap + sidePeek)) + 'px');

				return {
					cardWidth: cardWidth,
					fullCards: fullCards,
					gap: gap,
					maxScroll: Math.max(0, scroller.scrollWidth - scroller.clientWidth),
					sidePeek: sidePeek,
				};
			}

			function canScroll() {
				return scroller.scrollWidth > scroller.clientWidth + 2;
			}

			function scrollTargets() {
				var info = layoutInfo();

				return cards.map(function (card, index) {
					if (index === 0) {
						return 0;
					}

					return Math.max(0, Math.min(info.maxScroll, card.offsetLeft - info.gap - info.sidePeek));
				});
			}

			function clampScroll(left) {
				var info = layoutInfo();

				return Math.max(0, Math.min(info.maxScroll, left));
			}

			function nearestIndex(targets) {
				var nearest = 0;
				var nearestDistance = Infinity;

				targets.forEach(function (target, index) {
					var distance = Math.abs(scroller.scrollLeft - target);

					if (distance < nearestDistance) {
						nearest = index;
						nearestDistance = distance;
					}
				});

				return nearest;
			}

			function normalizeLoopIndex(index) {
				if (originalCount < 2) {
					return index;
				}

				if (index < firstOriginalIndex) {
					return index + originalCount;
				}

				if (index > lastOriginalIndex) {
					return index - originalCount;
				}

				return index;
			}

			function normalizeLoopPosition() {
				var targets = scrollTargets();
				var left;
				var start;
				var end;
				var loopSpan;

				if (!targets.length || originalCount < 2) {
					return;
				}

				start = targets[firstOriginalIndex];
				end = targets[lastOriginalIndex];
				loopSpan = start;
				left = scroller.scrollLeft;

				currentIndex = nearestIndex(targets);

				if (!loopSpan || (left >= start && left <= end)) {
					updateButtons();
					return;
				}

				while (left < start) {
					left += loopSpan;
				}

				while (left > end) {
					left -= loopSpan;
				}

				markProgrammaticScroll();
				scroller.scrollTo({
					behavior: 'auto',
					left: clampScroll(left),
				});
				currentIndex = nearestIndex(targets);
				updateButtons();
			}

			function stopMomentum() {
				if (momentumFrame) {
					window.cancelAnimationFrame(momentumFrame);
					momentumFrame = 0;
				}

				isMomentumScrolling = false;
			}

			function startMomentum() {
				var velocity = Math.max(-1.6, Math.min(1.6, dragVelocity));
				var previousTime;

				stopMomentum();

				if (prefersReducedMotion || Math.abs(velocity) < 0.08) {
					return;
				}

				isMomentumScrolling = true;
				previousTime = window.performance.now();

				function momentumStep(now) {
					var elapsed = Math.min(32, now - previousTime);
					var previousLeft = scroller.scrollLeft;
					var nextLeft;

					previousTime = now;
					nextLeft = clampScroll(previousLeft + (velocity * elapsed));
					scroller.scrollLeft = nextLeft;
					velocity *= Math.pow(0.92, elapsed / 16.67);

					if (Math.abs(velocity) < 0.015 || Math.abs(scroller.scrollLeft - previousLeft) < 0.25) {
						stopMomentum();
						return;
					}

					momentumFrame = window.requestAnimationFrame(momentumStep);
				}

				momentumFrame = window.requestAnimationFrame(momentumStep);
			}

			function updateButtons() {
				var hasOverflow = canScroll();
				var targets = scrollTargets();

				currentIndex = nearestIndex(targets);

				if (prevButton) {
					prevButton.disabled = !hasOverflow;
				}

				if (nextButton) {
					nextButton.disabled = !hasOverflow;
				}

				if (carousel) {
					carousel.classList.toggle('is-at-start', !hasOverflow);
					carousel.classList.toggle('is-at-end', !hasOverflow);
				}
			}

			function scheduleUpdate() {
				if (frame) {
					return;
				}

				frame = window.requestAnimationFrame(function () {
					frame = 0;
					updateButtons();
				});
			}

			function markProgrammaticScroll() {
				isProgrammaticScroll = true;
				window.clearTimeout(programmaticTimer);
				programmaticTimer = window.setTimeout(function () {
					isProgrammaticScroll = false;
				}, prefersReducedMotion ? 80 : 520);
			}

			function snapToNearest(behavior) {
				var targets = scrollTargets();
				var targetIndex;

				if (!targets.length || !canScroll()) {
					return;
				}

				targetIndex = nearestIndex(targets);
				currentIndex = Math.max(0, Math.min(targets.length - 1, targetIndex));
				markProgrammaticScroll();
				scroller.scrollTo({
					behavior: prefersReducedMotion ? 'auto' : behavior,
					left: targets[currentIndex],
				});
			}

			function scheduleSnap(delay) {
				window.clearTimeout(snapTimer);
				snapTimer = window.setTimeout(function () {
					snapToNearest('smooth');
				}, delay);
			}

			function move(direction) {
				var targets = scrollTargets();
				var targetIndex;

				if (!targets.length || !canScroll()) {
					return;
				}

				normalizeLoopPosition();
				targets = scrollTargets();
				currentIndex = normalizeLoopIndex(nearestIndex(targets));
				targetIndex = currentIndex + (direction > 0 ? 1 : -1);

				if (targetIndex < 0) {
					targetIndex = targets.length - 1;
				} else if (targetIndex > targets.length - 1) {
					targetIndex = 0;
				}

				currentIndex = Math.max(0, Math.min(targets.length - 1, targetIndex));
				markProgrammaticScroll();
				scroller.scrollTo({
					behavior: prefersReducedMotion ? 'auto' : 'smooth',
					left: targets[currentIndex],
				});
				updateButtons();
			}

			if (prevButton) {
				prevButton.addEventListener('click', function () {
					move(-1);
				});
			}

			if (nextButton) {
				nextButton.addEventListener('click', function () {
					move(1);
				});
			}

			function endDrag() {
				if (!isDragging) {
					return;
				}

				isDragging = false;
				dragPointerId = null;
				hasPointerCapture = false;
				scroller.classList.remove('is-pointer-down');
				scroller.classList.remove('is-dragging');

				if (didDrag) {
					suppressClickUntil = Date.now() + 350;
					startMomentum();
				}

				window.setTimeout(function () {
					didDrag = false;
				}, 360);
			}

			scroller.addEventListener('pointerdown', function (event) {
				if (
					!canScroll()
					|| event.pointerType === 'touch'
					|| (event.pointerType === 'mouse' && event.button !== 0)
				) {
					return;
				}

				isDragging = true;
				didDrag = false;
				stopMomentum();
				normalizeLoopPosition();
				dragPointerId = event.pointerId;
				hasPointerCapture = false;
				dragStartX = event.clientX;
				dragStartScrollLeft = scroller.scrollLeft;
				dragLastTime = window.performance.now();
				dragLastScrollLeft = scroller.scrollLeft;
				dragVelocity = 0;
				scroller.classList.add('is-pointer-down');
			});

			scroller.addEventListener('pointermove', function (event) {
				if (!isDragging || (dragPointerId !== null && event.pointerId !== dragPointerId)) {
					return;
				}

				var deltaX = event.clientX - dragStartX;
				if (Math.abs(deltaX) > 4) {
					didDrag = true;
					scroller.classList.add('is-dragging');
					if (!hasPointerCapture && scroller.setPointerCapture) {
						try {
							scroller.setPointerCapture(event.pointerId);
							hasPointerCapture = true;
						} catch (error) {
							// Pointer capture is a progressive enhancement for smoother drag.
						}
					}
				}

				if (didDrag) {
					var now = window.performance.now();
					var elapsed = Math.max(1, now - dragLastTime);
					var nextLeft = clampScroll(dragStartScrollLeft - (deltaX * dragSensitivity));
					var instantVelocity;

					event.preventDefault();
					window.clearTimeout(snapTimer);
					scroller.scrollLeft = nextLeft;
					instantVelocity = (scroller.scrollLeft - dragLastScrollLeft) / elapsed;
					dragVelocity = (dragVelocity * 0.35) + (instantVelocity * 0.65);
					dragLastTime = now;
					dragLastScrollLeft = scroller.scrollLeft;
				}
			});

			scroller.addEventListener('pointerup', endDrag);
			scroller.addEventListener('pointercancel', endDrag);
			scroller.addEventListener('lostpointercapture', endDrag);
			scroller.addEventListener('dragstart', function (event) {
				event.preventDefault();
			});
			scroller.addEventListener('click', function (event) {
				if (!didDrag && Date.now() > suppressClickUntil) {
					return;
				}

				event.preventDefault();
				event.stopImmediatePropagation();
			}, true);
			scroller.addEventListener('wheel', function (event) {
				var horizontalDelta = Math.abs(event.deltaX) > Math.abs(event.deltaY) * 0.55 ? event.deltaX : 0;
				var unit = event.deltaMode === 1 ? 16 : (event.deltaMode === 2 ? scroller.clientWidth : 1);

				if (!horizontalDelta || !canScroll()) {
					return;
				}

				event.preventDefault();
				window.clearTimeout(snapTimer);
				normalizeLoopPosition();
				scroller.scrollLeft = clampScroll(scroller.scrollLeft + (horizontalDelta * unit * wheelSensitivity));
			}, { passive: false });
			scroller.addEventListener('scroll', function () {
				scheduleUpdate();
			}, { passive: true });
			window.addEventListener('resize', function () {
				window.setTimeout(function () {
					var targets = scrollTargets();
					normalizeLoopPosition();
					markProgrammaticScroll();
					scroller.scrollTo({
						behavior: 'auto',
						left: targets[Math.max(0, Math.min(targets.length - 1, currentIndex))],
					});
					updateButtons();
				}, 120);
			}, { passive: true });

			setupLoop();
			(function () {
				var targets = scrollTargets();

				if (targets[firstOriginalIndex]) {
					markProgrammaticScroll();
					scroller.scrollTo({
						behavior: 'auto',
						left: targets[firstOriginalIndex],
					});
					currentIndex = firstOriginalIndex;
				}

				updateButtons();
			}());
			updateButtons();
			window.setTimeout(updateButtons, 250);
		});
	});
}());

(function () {
	'use strict';

	/*
	 * Product images are WooCommerce media and can contain very different white
	 * margins. Measure only same-origin images, cache the result per source, and
	 * cap every upscale by the detected product bounds. If canvas/CORS/decoding is
	 * unavailable, CSS remains a safe contain box at scale 1.
	 */
	var IMAGE_SELECTOR = '[data-siini-product-card] .siini-home-product-card__media img';
	var NORMAL_SCALE_VAR = '--siini-card-media-normalize-scale';
	var HOVER_SCALE_VAR = '--siini-card-media-normalize-hover-scale';
	var PROFILE_CACHE = Object.create(null);
	var TARGET_LONG_SIDE = 0.78;
	var MIN_SCALE = 0.72;
	var MAX_SCALE = 1.28;
	var scanFrame = 0;

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function scheduleScan() {
		if (scanFrame) {
			return;
		}

		if (window.requestAnimationFrame) {
			scanFrame = window.requestAnimationFrame(scan);
			return;
		}

		scanFrame = window.setTimeout(scan, 40);
	}

	function sourceKey(image) {
		return image.currentSrc || image.src || '';
	}

	function isSameOrigin(source) {
		var url;

		try {
			url = new URL(source, window.location.href);
		} catch (error) {
			return false;
		}

		return url.origin === window.location.origin;
	}

	function nearWhite(data, offset) {
		return data[offset + 3] > 8
			&& data[offset] > 232
			&& data[offset + 1] > 232
			&& data[offset + 2] > 232;
	}

	function measureWhiteField(image) {
		var source = sourceKey(image);
		var naturalWidth = image.naturalWidth;
		var naturalHeight = image.naturalHeight;
		var sampleScale;
		var width;
		var height;
		var canvas;
		var context;
		var data;
		var corners;
		var minX;
		var minY;
		var maxX;
		var maxY;
		var marked = 0;
		var x;
		var y;
		var offset;
		var red;
		var green;
		var blue;
		var alpha;
		var nonWhite;
		var edge;
		var bounds;

		if (!source || !isSameOrigin(source) || !image.complete || !naturalWidth || !naturalHeight) {
			return null;
		}

		sampleScale = Math.min(1, 192 / Math.max(naturalWidth, naturalHeight));
		width = Math.max(1, Math.round(naturalWidth * sampleScale));
		height = Math.max(1, Math.round(naturalHeight * sampleScale));

		try {
			canvas = document.createElement('canvas');
			canvas.width = width;
			canvas.height = height;
			context = canvas.getContext('2d', { willReadFrequently: true });
			if (!context) {
				return null;
			}

			context.drawImage(image, 0, 0, width, height);
			data = context.getImageData(0, 0, width, height).data;
		} catch (error) {
			return null;
		}

		corners = [
			0,
			(width - 1) * 4,
			((height - 1) * width) * 4,
			((height - 1) * width + width - 1) * 4,
		];

		if (!corners.every(function (corner) {
			return nearWhite(data, corner);
		})) {
			return null;
		}

		minX = width;
		minY = height;
		maxX = -1;
		maxY = -1;

		for (y = 0; y < height; y += 1) {
			for (x = 0; x < width; x += 1) {
				offset = (y * width + x) * 4;
				red = data[offset];
				green = data[offset + 1];
				blue = data[offset + 2];
				alpha = data[offset + 3];
				nonWhite = alpha > 8 && (red < 244 || green < 244 || blue < 244);

				if (!nonWhite) {
					continue;
				}

				marked += 1;
				minX = Math.min(minX, x);
				minY = Math.min(minY, y);
				maxX = Math.max(maxX, x);
				maxY = Math.max(maxY, y);
			}
		}

		if (marked < 6 || maxX < 0 || maxY < 0) {
			return null;
		}

		/* Add a conservative safety envelope so light product edges are not clipped. */
		edge = 0.04;
		bounds = {
			left: Math.max(0, minX / width - edge),
			top: Math.max(0, minY / height - edge),
			right: Math.min(1, (maxX + 1) / width + edge),
			bottom: Math.min(1, (maxY + 1) / height + edge),
		};

		/* Full-frame photos do not have white fields to normalize. */
		if (bounds.right - bounds.left > 0.985 && bounds.bottom - bounds.top > 0.985) {
			return null;
		}

		return {
			width: naturalWidth,
			height: naturalHeight,
			bounds: bounds,
		};
	}

	function getWhiteFieldProfile(image) {
		var source = sourceKey(image);

		if (!source || Object.prototype.hasOwnProperty.call(PROFILE_CACHE, source)) {
			return PROFILE_CACHE[source] || null;
		}

		PROFILE_CACHE[source] = measureWhiteField(image) || false;
		return PROFILE_CACHE[source] || null;
	}

	function safeAxisScale(start, end, size) {
		var center = size / 2;
		var result = Infinity;

		if (start < center) {
			result = Math.min(result, center / (center - start));
		}

		if (end > center) {
			result = Math.min(result, (size - center) / (end - center));
		}

		return result;
	}

	function scaleForImage(image, profile) {
		var media = image.closest('.siini-home-product-card__media');
		var mediaRect;
		var mediaWidth;
		var mediaHeight;
		var sourceRatio;
		var fittedWidth;
		var fittedHeight;
		var offsetX;
		var offsetY;
		var contentLeft;
		var contentTop;
		var contentRight;
		var contentBottom;
		var occupancy;
		var desired;
		var safe;
		var scale;
		var hoverScale;

		if (!media || !profile) {
			return { scale: 1, hoverScale: 1 };
		}

		mediaRect = media.getBoundingClientRect();
		mediaWidth = mediaRect.width;
		mediaHeight = mediaRect.height;

		if (!mediaWidth || !mediaHeight) {
			return { scale: 1, hoverScale: 1 };
		}

		sourceRatio = profile.width / profile.height;
		fittedWidth = mediaWidth;
		fittedHeight = mediaWidth / sourceRatio;

		if (fittedHeight > mediaHeight) {
			fittedHeight = mediaHeight;
			fittedWidth = mediaHeight * sourceRatio;
		}

		offsetX = (mediaWidth - fittedWidth) / 2;
		offsetY = (mediaHeight - fittedHeight) / 2;
		contentLeft = offsetX + fittedWidth * profile.bounds.left;
		contentTop = offsetY + fittedHeight * profile.bounds.top;
		contentRight = offsetX + fittedWidth * profile.bounds.right;
		contentBottom = offsetY + fittedHeight * profile.bounds.bottom;
		occupancy = Math.max(
			(contentRight - contentLeft) / mediaWidth,
			(contentBottom - contentTop) / mediaHeight
		);

		if (!occupancy || !isFinite(occupancy)) {
			return { scale: 1, hoverScale: 1 };
		}

		desired = TARGET_LONG_SIDE / occupancy;
		safe = Math.min(
			safeAxisScale(contentLeft, contentRight, mediaWidth),
			safeAxisScale(contentTop, contentBottom, mediaHeight)
		);

		if (!isFinite(safe) || safe <= 0) {
			return { scale: 1, hoverScale: 1 };
		}

		/* The 0.96 guard leaves a little visual air even when thresholding misses an edge. */
		safe *= 0.96;
		scale = Math.min(Math.max(desired, MIN_SCALE), Math.min(MAX_SCALE, safe));
		scale = Math.max(0.1, scale);
		hoverScale = Math.min(safe, Math.min(MAX_SCALE, scale * 1.015));

		return {
			scale: scale,
			hoverScale: Math.max(scale, hoverScale),
		};
	}

	function boxKey(media) {
		var rect = media.getBoundingClientRect();

		return Math.round(rect.width * 10) + 'x' + Math.round(rect.height * 10);
	}

	function setScale(image, result, source, box) {
		image.style.setProperty(NORMAL_SCALE_VAR, result.scale.toFixed(3), 'important');
		image.style.setProperty(HOVER_SCALE_VAR, result.hoverScale.toFixed(3), 'important');
		image.setAttribute('data-siini-media-scale-source', source);
		image.setAttribute('data-siini-media-scale-box', box);
	}

	function normalizeImage(image) {
		var source = sourceKey(image);
		var media = image.closest('.siini-home-product-card__media');
		var box;
		var result;
		var profile;

		if (!media || !source || !isSameOrigin(source)) {
			return;
		}

		if (!image.complete || !image.naturalWidth) {
			if (!image.siiniMediaScaleLoadBound) {
				image.siiniMediaScaleLoadBound = true;
				image.addEventListener('load', function () {
					image.siiniMediaScaleLoadBound = false;
					normalizeImage(image);
					scheduleScan();
				}, { once: true });
			}

			return;
		}

		box = boxKey(media);
		if (
			image.getAttribute('data-siini-media-scale-source') === source
			&& image.getAttribute('data-siini-media-scale-box') === box
		) {
			return;
		}

		profile = getWhiteFieldProfile(image);
		result = scaleForImage(image, profile);
		setScale(image, result, source, box);
	}

	function scan() {
		scanFrame = 0;
		Array.prototype.slice.call(document.querySelectorAll(IMAGE_SELECTOR)).forEach(normalizeImage);
	}

	ready(function () {
		if (!document.body) {
			return;
		}

		scheduleScan();
		window.addEventListener('load', scheduleScan);
		window.addEventListener('resize', scheduleScan);

		if (window.MutationObserver && document.body) {
			new window.MutationObserver(scheduleScan).observe(document.body, {
				childList: true,
				subtree: true,
			});
		}
	});
}());

(function () {
	'use strict';

	var STORAGE_KEY = 'siini_favorites_v1';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function readFavorites() {
		try {
			var raw = window.localStorage.getItem(STORAGE_KEY);
			var parsed = raw ? JSON.parse(raw) : [];
			var list = Array.isArray(parsed) ? parsed : Object.keys(parsed || {}).map(function (key) {
				return parsed[key];
			});
			var map = {};

			list.forEach(function (item) {
				if (item && item.productId) {
					map[String(item.productId)] = item;
				}
			});

			return map;
		} catch (error) {
			return {};
		}
	}

	function writeFavorites(map) {
		var list = Object.keys(map).map(function (key) {
			return map[key];
		}).sort(function (a, b) {
			return (b.timestamp || 0) - (a.timestamp || 0);
		});

		try {
			window.localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
		} catch (error) {}

		return list;
	}

	function cardFromToggle(toggle) {
		return toggle ? toggle.closest('[data-siini-product-card]') : null;
	}

	function productId(card) {
		return card ? String(card.getAttribute('data-product-id') || '') : '';
	}

	function config() {
		return window.siiniSite || {};
	}

	function endpoint() {
		return config().addToCartEndpoint || '/?wc-ajax=add_to_cart';
	}

	function favoriteCartEndpoint() {
		return config().favoriteCartEndpoint || endpoint();
	}

	function cartUrl() {
		return config().cartUrl || '/cart/';
	}

	function collectFavoriteSizes(card) {
		var root = card.querySelector('.siini-home-product-card__body') || card;
		var seen = {};

		return Array.prototype.slice.call(root.querySelectorAll('[data-siini-card-size]')).map(function (button) {
			var value = button.getAttribute('data-attribute-value') || '';
			var variationId = button.getAttribute('data-variation-id') || '';
			var key = variationId + ':' + value;

			if (seen[key]) {
				return null;
			}

			seen[key] = true;

			return {
				label: (button.textContent || '').trim(),
				variationId: variationId,
				attributeName: button.getAttribute('data-attribute-name') || 'attribute_pa_size',
				attributeValue: value,
				productId: button.getAttribute('data-product-id') || productId(card),
				productType: button.getAttribute('data-product-type') || card.getAttribute('data-product-type') || '',
			};
		}).filter(function (size) {
			return !!(size && size.label && size.attributeValue);
		});
	}

	function fallbackCopyText(value) {
		var textarea;

		textarea = document.createElement('textarea');
		textarea.value = value;
		textarea.setAttribute('readonly', 'readonly');
		textarea.style.position = 'fixed';
		textarea.style.left = '-9999px';
		document.body.appendChild(textarea);
		textarea.select();

		try {
			document.execCommand('copy');
		} catch (error) {}

		document.body.removeChild(textarea);

		return Promise.resolve();
	}

	function copyText(value) {
		if (window.navigator.clipboard && window.navigator.clipboard.writeText) {
			return window.navigator.clipboard.writeText(value).catch(function () {
				return fallbackCopyText(value);
			});
		}

		return fallbackCopyText(value);
	}

	function markCopied(button) {
		var originalLabel = button.getAttribute('aria-label') || 'Скопировать ссылку';
		var originalTitle = button.getAttribute('title') || '';

		button.classList.add('is-copied');
		button.setAttribute('aria-label', 'Ссылка скопирована');
		button.setAttribute('title', 'Ссылка скопирована');

		window.setTimeout(function () {
			button.classList.remove('is-copied');
			button.setAttribute('aria-label', originalLabel);
			if (originalTitle) {
				button.setAttribute('title', originalTitle);
			} else {
				button.removeAttribute('title');
			}
		}, 1400);
	}

	function ensureStatusToast() {
		var toast = document.querySelector('[data-siini-status-toast]');

		if (toast) {
			return toast;
		}

		toast = document.createElement('div');
		toast.className = 'siini-status-toast';
		toast.setAttribute('data-siini-status-toast', '');
		toast.setAttribute('role', 'status');
		toast.setAttribute('aria-live', 'polite');
		toast.setAttribute('aria-atomic', 'true');
		toast.hidden = true;
		document.body.appendChild(toast);

		return toast;
	}

	function flashStatusToast(message) {
		var toast = ensureStatusToast();

		if (!toast) {
			return;
		}

		if (toast._timer) {
			window.clearTimeout(toast._timer);
		}

		toast.textContent = message;
		toast.hidden = false;
		toast.classList.add('is-visible');

		toast._timer = window.setTimeout(function () {
			toast.classList.remove('is-visible');
			toast.hidden = true;
		}, 1500);
	}

	function collectFavorite(card) {
		var titleNode = card.querySelector('h3 a');
		var imageNode = card.querySelector('.siini-home-product-card__image');
		var currentPriceNode = card.querySelector('[data-siini-card-current-price]');
		var oldPriceNode = card.querySelector('[data-siini-card-old-price]');
		var id = productId(card);

		return {
			productId: id,
			title: card.getAttribute('data-siini-favorite-title') || (titleNode ? titleNode.textContent.trim() : ''),
			brand: card.getAttribute('data-siini-favorite-brand') || '',
			priceText: card.getAttribute('data-siini-favorite-price') || (currentPriceNode ? currentPriceNode.textContent.trim() : ''),
			oldPriceText: card.getAttribute('data-siini-favorite-old-price') || (oldPriceNode ? oldPriceNode.textContent.trim() : ''),
			permalink: card.getAttribute('data-siini-favorite-url') || (titleNode ? titleNode.href : ''),
			imageSrc: card.getAttribute('data-siini-favorite-image') || (imageNode ? imageNode.currentSrc || imageNode.src : ''),
			productType: card.getAttribute('data-product-type') || '',
			sizes: collectFavoriteSizes(card),
			selectedSizeValue: '',
			selectedSizeLabel: '',
			selectedVariationId: '',
			added: false,
			timestamp: Date.now(),
		};
	}

	function setToggleState(button, active) {
		button.classList.toggle('is-active', active);
		button.setAttribute('aria-pressed', active ? 'true' : 'false');
		button.setAttribute('aria-label', active ? 'Убрать из избранного' : 'Добавить в избранное');
		button.textContent = active ? '♥' : '♡';
	}

	function updateCounters(count) {
		Array.prototype.slice.call(document.querySelectorAll('[data-siini-favorites-count]')).forEach(function (node) {
			node.textContent = String(count);
			node.hidden = count <= 0;
		});
	}

	function clearNode(node) {
		while (node.firstChild) {
			node.removeChild(node.firstChild);
		}
	}

	function appendText(parent, tag, className, text) {
		var node = document.createElement(tag);
		node.className = className;
		node.textContent = text || '';
		parent.appendChild(node);
		return node;
	}

	function selectedFavoriteSize(item) {
		var sizes = Array.isArray(item.sizes) ? item.sizes : [];
		var selectedValue = String(item.selectedSizeValue || '');
		var selectedVariationId = String(item.selectedVariationId || '');

		if (!sizes.length) {
			return null;
		}

		return sizes.find(function (size) {
			return (selectedVariationId && String(size.variationId || '') === selectedVariationId) ||
				(selectedValue && String(size.attributeValue || '') === selectedValue);
		}) || null;
	}

	function renderFavoriteSizes(body, item) {
		var sizes = Array.isArray(item.sizes) ? item.sizes : [];
		var selected = selectedFavoriteSize(item);
		var wrap;

		if (!sizes.length) {
			return;
		}

		wrap = document.createElement('div');
		wrap.className = 'siini-favorites-drawer__sizes';
		wrap.setAttribute('aria-label', 'Выберите размер');

		sizes.forEach(function (size) {
			var button = document.createElement('button');
			var isSelected = selected && String(selected.attributeValue || '') === String(size.attributeValue || '');

			button.className = 'siini-favorites-drawer__size';
			button.type = 'button';
			button.textContent = size.label || size.attributeValue || '';
			button.setAttribute('aria-label', 'Выбрать размер ' + button.textContent);
			button.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
			button.setAttribute('data-siini-favorite-size', String(item.productId || ''));
			button.setAttribute('data-attribute-name', size.attributeName || 'attribute_pa_size');
			button.setAttribute('data-attribute-value', size.attributeValue || '');
			button.setAttribute('data-variation-id', size.variationId || '');
			button.classList.toggle('is-selected', !!isSelected);
			wrap.appendChild(button);
		});

		body.appendChild(wrap);
	}

	function renderFavoriteActions(item) {
		var sizes = Array.isArray(item.sizes) ? item.sizes : [];
		var productType = item.productType || (sizes.length ? 'variable' : '');
		var selected = selectedFavoriteSize(item);
		var needsSize = sizes.length > 0;
		var canAddSimple = productType && productType !== 'variable' && sizes.length === 0;
		var hasAddFlow = (needsSize && !!selected) || canAddSimple;
		var actions = document.createElement('div');
		var iconActions = document.createElement('div');
		var commands = document.createElement('div');
		var remove = document.createElement('button');
		var copy = document.createElement('button');
		var copyIcon = document.createElement('span');
		var add = item.added ? document.createElement('a') : document.createElement('button');
		var open = document.createElement('a');
		var message = document.createElement('p');

		actions.className = 'siini-favorites-drawer__actions';
		iconActions.className = 'siini-favorites-drawer__icon-actions';
		commands.className = 'siini-favorites-drawer__commands';

		remove.className = 'siini-favorites-drawer__remove';
		remove.type = 'button';
		remove.setAttribute('aria-label', 'Убрать из избранного');
		remove.setAttribute('title', 'Убрать из избранного');
		remove.setAttribute('data-siini-favorite-remove', item.productId);
		remove.textContent = '♥';
		iconActions.appendChild(remove);

		copy.className = 'siini-favorites-drawer__copy';
		copy.type = 'button';
		copy.setAttribute('data-siini-card-copy-link', '');
		copy.setAttribute('data-copy-url', item.permalink || '/shop/');
		copy.setAttribute('aria-label', 'Скопировать ссылку');
		copy.setAttribute('title', 'Скопировать ссылку');
		copyIcon.className = 'dashicons dashicons-admin-links';
		copyIcon.setAttribute('aria-hidden', 'true');
		copy.appendChild(copyIcon);
		iconActions.appendChild(copy);

		actions.appendChild(iconActions);

		if (needsSize || canAddSimple) {
			add.className = 'siini-favorites-drawer__cart';
			if (item.added) {
				add.href = cartUrl();
				add.textContent = 'Перейти в корзину';
			} else {
				add.type = 'button';
				add.setAttribute('data-siini-favorite-add', String(item.productId || ''));
				add.disabled = !hasAddFlow;
				add.textContent = hasAddFlow ? 'В корзину' : 'Выберите размер';
			}
			commands.appendChild(add);
		}

		open.className = 'siini-favorites-drawer__open';
		open.href = item.permalink || '/shop/';
		open.textContent = 'Открыть товар';
		commands.appendChild(open);

		actions.appendChild(commands);

		message.className = 'siini-favorites-drawer__message';
		message.setAttribute('data-siini-favorite-message', String(item.productId || ''));
		message.setAttribute('role', 'status');
		message.setAttribute('aria-live', 'polite');
		message.textContent = item.added ? 'Товар добавлен в корзину. Кнопка ведет в корзину.' : '';
		message.hidden = !item.added;
		actions.appendChild(message);

		return actions;
	}

	function renderDrawer(list) {
		var content = document.querySelector('[data-siini-favorites-content]');

		if (!content) {
			return;
		}

		clearNode(content);

		if (!list.length) {
			var empty = document.createElement('div');
			var link = document.createElement('a');

			empty.className = 'siini-favorites-drawer__empty';
			appendText(empty, 'p', 'siini-favorites-drawer__empty-text', 'В избранном пока пусто');
			link.className = 'siini-favorites-drawer__catalog';
			link.href = '/shop/';
			link.textContent = 'В каталог';
			empty.appendChild(link);
			content.appendChild(empty);
			return;
		}

		list.forEach(function (item) {
			var row = document.createElement('article');
			var media = document.createElement('a');
			var image = document.createElement('img');
			var body = document.createElement('div');
			var title = document.createElement('a');
			var price = document.createElement('p');
			var actions = renderFavoriteActions(item);

			row.className = 'siini-favorites-drawer__item';
			row.setAttribute('data-siini-favorite-item', String(item.productId || ''));
			row.classList.toggle('is-added', !!item.added);
			media.className = 'siini-favorites-drawer__media';
			media.href = item.permalink || '/shop/';
			image.alt = item.title || '';
			// Drawer thumbnails are rendered inside a hidden off-canvas panel.
			// Lazy-loading keeps them in an incomplete state in Chromium DOM scans,
			// even when the underlying thumbnail URL is healthy, so load them eagerly.
			image.loading = 'eager';
			image.decoding = 'async';
			image.src = item.imageSrc || '';
			media.appendChild(image);

			body.className = 'siini-favorites-drawer__body';
			appendText(body, 'p', 'siini-favorites-drawer__brand', item.brand || 'SINI');
			title.className = 'siini-favorites-drawer__title';
			title.href = item.permalink || '/shop/';
			title.textContent = item.title || 'Товар';
			body.appendChild(title);

			price.className = 'siini-favorites-drawer__price';
			appendText(price, 'span', 'siini-favorites-drawer__price-current', item.priceText || '');
			if (item.oldPriceText) {
				appendText(price, 'del', 'siini-favorites-drawer__price-old', item.oldPriceText);
			}
			body.appendChild(price);

			renderFavoriteSizes(body, item);
			if (!Array.isArray(item.sizes) || (!item.sizes.length && item.productType === 'variable')) {
				appendText(body, 'p', 'siini-favorites-drawer__note', 'Размер можно выбрать на странице товара.');
			}

			row.appendChild(media);
			row.appendChild(body);
			row.appendChild(actions);
			content.appendChild(row);
		});
	}

	function ensureDrawerInBody() {
		var drawer = document.querySelector('[data-siini-favorites-drawer]');

		if (drawer && drawer.parentNode !== document.body) {
			document.body.appendChild(drawer);
		}
	}

	function syncFavorites() {
		ensureDrawerInBody();

		var map = readFavorites();
		var list = Object.keys(map).map(function (key) {
			return map[key];
		}).sort(function (a, b) {
			return (b.timestamp || 0) - (a.timestamp || 0);
		});

		Array.prototype.slice.call(document.querySelectorAll('[data-siini-favorite-toggle]')).forEach(function (button) {
			var id = productId(cardFromToggle(button));
			setToggleState(button, !!(id && map[id]));
		});

		updateCounters(list.length);
		renderDrawer(list);
	}

	window.siiniSyncFavorites = syncFavorites;

	function applyFragments(response) {
		if (!response || !response.fragments) {
			return;
		}

		Object.keys(response.fragments).forEach(function (selector) {
			var fragment = response.fragments[selector];
			var nodes = Array.prototype.slice.call(document.querySelectorAll(selector));

			nodes.forEach(function (node) {
				var wrapper = document.createElement('div');
				wrapper.innerHTML = fragment;
				if (wrapper.firstElementChild) {
					node.replaceWith(wrapper.firstElementChild);
				}
			});
		});
	}

	function dispatchCartEvents(response, trigger) {
		if (window.jQuery) {
			window.jQuery(document.body).trigger('added_to_cart', [
				response && response.fragments ? response.fragments : {},
				response && response.cart_hash ? response.cart_hash : '',
				window.jQuery(trigger),
			]);
		}

		document.body.dispatchEvent(new window.CustomEvent('wc-blocks_added_to_cart', {
			bubbles: true,
			detail: { preserveCartData: false },
		}));
	}

	function markCartIndicator() {
		var badges = Array.prototype.slice.call(document.querySelectorAll('.wc-block-mini-cart__badge'));
		var quantityBadges = Array.prototype.slice.call(document.querySelectorAll('.wc-block-mini-cart__quantity-badge'));

		if (!badges.length) {
			quantityBadges.forEach(function (quantityBadge) {
				var badge = document.createElement('span');

				badge.className = 'wc-block-mini-cart__badge';
				badge.setAttribute('aria-hidden', 'true');
				badge.textContent = '1';
				quantityBadge.appendChild(badge);
				badges.push(badge);
			});
		}

		badges.forEach(function (badge) {
			badge.hidden = false;
			if (!(badge.textContent || '').trim()) {
				badge.textContent = '1';
			}
		});
	}

	function setFavoriteMessage(row, text, isError) {
		var message = row ? row.querySelector('[data-siini-favorite-message]') : null;

		if (!message) {
			return;
		}

		message.textContent = text || '';
		message.hidden = !text;
		message.classList.toggle('is-error', !!isError);
	}

	function favoriteAddToCart(item, trigger) {
		var sizes = Array.isArray(item.sizes) ? item.sizes : [];
		var type = item.productType || (sizes.length ? 'variable' : '');
		var selected = selectedFavoriteSize(item);
		var variationId = selected ? parseInt(selected.variationId || '0', 10) || 0 : 0;
		var productId = parseInt(item.productId || '0', 10) || 0;
		var body = new window.URLSearchParams();
		var settings = config();
		var requestEndpoint;
		var requestOptions;

		if (type === 'variable' && !variationId) {
			return Promise.reject(new Error('missing-size'));
		}

		if (!productId) {
			return Promise.reject(new Error('missing-product'));
		}

		body.set('product_id', String(productId));
		body.set('quantity', '1');

		if (settings.favoriteCartAction) {
			body.set('action', settings.favoriteCartAction);
		}

		if (variationId) {
			body.set('variation_id', String(variationId));
		}

		if (selected && selected.attributeName) {
			body.set(selected.attributeName, selected.attributeValue || '');
		}

		trigger.classList.add('is-loading');
		trigger.setAttribute('aria-busy', 'true');

		requestEndpoint = favoriteCartEndpoint();
		requestOptions = {
			method: 'POST',
			credentials: 'same-origin',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
				'X-Requested-With': 'XMLHttpRequest',
			},
			body: body.toString(),
		};

		return window.fetch(requestEndpoint, requestOptions).then(function (response) {
			return response.json();
		}).then(function (response) {
			if (response && response.error) {
				throw new Error('add-to-cart-error');
			}

			applyFragments(response);
			dispatchCartEvents(response, trigger);
			markCartIndicator();
			return response;
		}).finally(function () {
			trigger.classList.remove('is-loading');
			trigger.removeAttribute('aria-busy');
		});
	}

	function openDrawer() {
		ensureDrawerInBody();

		var drawer = document.querySelector('[data-siini-favorites-drawer]');
		var panel = drawer ? drawer.querySelector('.siini-favorites-drawer__panel') : null;

		if (!drawer) {
			return;
		}

		syncFavorites();
		drawer.hidden = false;
		document.documentElement.classList.add('siini-favorites-open');
		document.body.classList.add('siini-favorites-open');
		Array.prototype.slice.call(document.querySelectorAll('[data-siini-favorites-open]')).forEach(function (button) {
			button.setAttribute('aria-expanded', 'true');
		});

		if (panel) {
			panel.focus({ preventScroll: true });
		}
	}

	function closeDrawer() {
		ensureDrawerInBody();

		var drawer = document.querySelector('[data-siini-favorites-drawer]');

		if (drawer) {
			drawer.hidden = true;
		}

		document.documentElement.classList.remove('siini-favorites-open');
		document.body.classList.remove('siini-favorites-open');
		Array.prototype.slice.call(document.querySelectorAll('[data-siini-favorites-open]')).forEach(function (button) {
			button.setAttribute('aria-expanded', 'false');
		});
	}

	ready(function () {
		document.addEventListener('click', function (event) {
			var toggle = event.target.closest('[data-siini-favorite-toggle]');
			var copyLink = event.target.closest('[data-siini-card-copy-link]');
			var opener = event.target.closest('[data-siini-favorites-open]');
			var closer = event.target.closest('[data-siini-favorites-close]');
			var remove = event.target.closest('[data-siini-favorite-remove]');
			var favoriteSize = event.target.closest('[data-siini-favorite-size]');
			var favoriteAdd = event.target.closest('[data-siini-favorite-add]');
			var map;
			var card;
			var id;

			if (copyLink) {
				event.preventDefault();
				event.stopPropagation();
				copyText(copyLink.getAttribute('data-copy-url') || window.location.href).then(function () {
					markCopied(copyLink);
					flashStatusToast('Ссылка скопирована');
				});
				return;
			}

			if (favoriteSize) {
				event.preventDefault();
				id = String(favoriteSize.getAttribute('data-siini-favorite-size') || '');
				map = readFavorites();
				if (!id || !map[id]) {
					return;
				}
				map[id].selectedSizeValue = favoriteSize.getAttribute('data-attribute-value') || '';
				map[id].selectedSizeLabel = (favoriteSize.textContent || '').trim();
				map[id].selectedVariationId = favoriteSize.getAttribute('data-variation-id') || '';
				map[id].selectedAttributeName = favoriteSize.getAttribute('data-attribute-name') || 'attribute_pa_size';
				map[id].added = false;
				writeFavorites(map);
				syncFavorites();
				return;
			}

			if (favoriteAdd) {
				event.preventDefault();
				id = String(favoriteAdd.getAttribute('data-siini-favorite-add') || '');
				map = readFavorites();
				if (!id || !map[id]) {
					return;
				}
				setFavoriteMessage(favoriteAdd.closest('.siini-favorites-drawer__item'), '', false);
				favoriteAddToCart(map[id], favoriteAdd).then(function () {
					var nextMap = readFavorites();
					if (nextMap[id]) {
						nextMap[id].added = true;
						nextMap[id].addedAt = Date.now();
						writeFavorites(nextMap);
						syncFavorites();
					}
				}).catch(function (error) {
					var row = favoriteAdd.closest('.siini-favorites-drawer__item');
					var message = error && error.message === 'missing-size' ? 'Выберите размер.' : ((config().messages && config().messages.cartError) || 'Не получилось добавить. Попробуйте еще раз.');

					setFavoriteMessage(row, message, true);
				});
				return;
			}

			if (toggle) {
				event.preventDefault();
				event.stopPropagation();
				card = cardFromToggle(toggle);
				id = productId(card);
				if (!card || !id) {
					return;
				}
				map = readFavorites();
				if (map[id]) {
					delete map[id];
				} else {
					map[id] = collectFavorite(card);
				}
				writeFavorites(map);
				syncFavorites();
				return;
			}

			if (opener) {
				event.preventDefault();
				openDrawer();
				return;
			}

			if (closer) {
				event.preventDefault();
				closeDrawer();
				return;
			}

			if (remove) {
				event.preventDefault();
				map = readFavorites();
				delete map[String(remove.getAttribute('data-siini-favorite-remove') || '')];
				writeFavorites(map);
				syncFavorites();
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') {
				closeDrawer();
			}
		});

		window.addEventListener('storage', function (event) {
			if (event.key === STORAGE_KEY) {
				syncFavorites();
			}
		});

		syncFavorites();
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function config() {
		return window.siiniSite || {};
	}

	function cartUrl() {
		return config().cartUrl || '/cart/';
	}

	function endpoint() {
		return config().addToCartEndpoint || '/?wc-ajax=add_to_cart';
	}

	function favoriteCartEndpoint() {
		return config().favoriteCartEndpoint || endpoint();
	}

	function setMessage(card, message, isError) {
		var node = card.querySelector('[data-siini-card-message]');

		if (!node) {
			return;
		}

		node.textContent = message || '';
		node.classList.toggle('is-error', !!isError);
		node.hidden = !message;
	}

	function selectedSize(card) {
		return card.querySelector('[data-siini-card-size].is-selected');
	}

	function selectedVariationId(card) {
		var selected = selectedSize(card);

		if (!selected) {
			return 0;
		}

		return parseInt(selected.getAttribute('data-variation-id') || '0', 10) || 0;
	}

	function normalizeClothingSize(value) {
		var normalized = String(value || '').trim().toUpperCase().replace(/[\s_]+/g, '').replace(/×/g, 'X');

		if (!normalized) {
			return '';
		}

		if (normalized === '2XL') {
			return 'XXL';
		}

		if (normalized === '3XL') {
			return 'XXXL';
		}

		if (normalized === '4XL' || normalized === 'XXXXL') {
			return '4XL';
		}

		if (normalized === '5XL' || normalized === 'XXXXXL') {
			return '5XL';
		}

		if (normalized === '6XL' || normalized === 'XXXXXXL') {
			return '6XL';
		}

		return normalized;
	}

	function sizeSelectionRank(button, index) {
		var clothingOrder = {
			XS: 0,
			S: 1,
			M: 2,
			L: 3,
			XL: 4,
			XXL: 5,
			XXXL: 6,
			'4XL': 7,
			'5XL': 8,
			'6XL': 9,
		};
		var sources = [
			button.getAttribute('data-size-label') || '',
			button.textContent || '',
			button.getAttribute('data-attribute-value') || '',
		];
		var numericRank = null;
		var clothingRank = null;

		sources.some(function (source) {
			var normalized = String(source || '').trim().replace(',', '.');
			var match;

			if (!normalized) {
				return false;
			}

			match = normalized.match(/^\d+(?:\.\d+)?$/);
			if (match) {
				numericRank = parseFloat(match[0]);
				return true;
			}

			match = normalized.match(/\b(\d{2}(?:\.\d+)?)\b/);
			if (match) {
				numericRank = parseFloat(match[1]);
				return true;
			}

			normalized = normalizeClothingSize(normalized);
			if (Object.prototype.hasOwnProperty.call(clothingOrder, normalized)) {
				clothingRank = clothingOrder[normalized];
				return true;
			}

			return false;
		});

		if (numericRank !== null && !isNaN(numericRank)) {
			return [0, numericRank, index];
		}

		if (clothingRank !== null) {
			return [1, clothingRank, index];
		}

		return [2, index, index];
	}

	function isBetterDefaultSize(candidate, current) {
		var candidateRank = sizeSelectionRank(candidate.button, candidate.index);
		var currentRank = sizeSelectionRank(current.button, current.index);
		var i;

		for (i = 0; i < candidateRank.length; i += 1) {
			if (candidateRank[i] < currentRank[i]) {
				return true;
			}

			if (candidateRank[i] > currentRank[i]) {
				return false;
			}
		}

		return false;
	}

	function bestDefaultSizeButton(card, sizes) {
		var type = card.getAttribute('data-product-type') || '';
		var best = null;

		if (type !== 'variable') {
			return null;
		}

		sizes.forEach(function (button, index) {
			var variationId = parseInt(button.getAttribute('data-variation-id') || '0', 10) || 0;
			var candidate;

			if (variationId <= 0 || button.disabled || button.getAttribute('aria-disabled') === 'true') {
				return;
			}

			candidate = {
				button: button,
				index: index,
			};

			if (!best || isBetterDefaultSize(candidate, best)) {
				best = candidate;
			}
		});

		return best ? best.button : null;
	}

	function setSelectedSize(card, sizes, activeButton) {
		var cta = card.querySelector('[data-siini-card-cta]');
		var sizeGroup = card.querySelector('.siini-home-product-card__sizes');

		sizes.forEach(function (button) {
			var isActive = button === activeButton;
			button.classList.toggle('is-selected', isActive);
			button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
		});

		card.classList.remove('is-added');
		card.classList.remove('is-requesting-size');
		card.setAttribute('data-selected-quantity', '0');

		if (sizeGroup) {
			sizeGroup.setAttribute('aria-label', 'Доступные размеры');
		}

		if (cta) {
			cta.hidden = false;
		}

		Array.prototype.slice.call(card.querySelectorAll('[data-siini-card-added]')).forEach(function (node) {
			node.hidden = true;
		});

		setMessage(card, '', false);
		updateCtaForSelection(card);
	}

	function autoSelectDefaultSize(card, sizes) {
		var button;

		if (selectedSize(card)) {
			updateCtaForSelection(card);
			return;
		}

		button = bestDefaultSizeButton(card, sizes);
		if (!button) {
			updateCtaForSelection(card);
			return;
		}

		setSelectedSize(card, sizes, button);
	}

	function requestSizeSelection(card) {
		var sizes = card.querySelector('.siini-home-product-card__sizes');
		var firstSize = card.querySelector('[data-siini-card-size]');

		setMessage(card, '', false);
		card.classList.add('is-requesting-size');

		if (sizes) {
			sizes.setAttribute('aria-label', 'Выберите доступный размер перед добавлением в корзину');
		}

		if (firstSize) {
			try {
				firstSize.focus({ preventScroll: true });
			} catch (error) {
				firstSize.focus();
			}
		}
	}

	function updateCtaForSelection(card) {
		var cta = card.querySelector('[data-siini-card-cta]');
		var selected = selectedSize(card);
		var type = card.getAttribute('data-product-type') || cta && cta.getAttribute('data-product-type') || '';
		var hasVariation = selectedVariationId(card) > 0;

		if (!cta) {
			return;
		}

		if (selected && (type !== 'variable' || hasVariation)) {
			cta.textContent = cta.getAttribute('data-add-text') || 'В корзину';
			cta.classList.add('is-ready');
			cta.setAttribute('aria-disabled', 'false');
			card.classList.add('has-selected-size');
			return;
		}

		cta.textContent = cta.getAttribute('data-default-text') || 'Добавить в корзину';
		cta.classList.remove('is-ready');
		cta.setAttribute('aria-disabled', 'false');
		card.classList.remove('has-selected-size');
	}

	function applyFragments(response) {
		if (!response || !response.fragments) {
			return;
		}

		Object.keys(response.fragments).forEach(function (selector) {
			var fragment = response.fragments[selector];
			var nodes = Array.prototype.slice.call(document.querySelectorAll(selector));

			nodes.forEach(function (node) {
				var wrapper = document.createElement('div');
				wrapper.innerHTML = fragment;
				if (wrapper.firstElementChild) {
					node.replaceWith(wrapper.firstElementChild);
				}
			});
		});
	}

	function dispatchCartEvents(response, cta) {
		if (window.jQuery) {
			window.jQuery(document.body).trigger('added_to_cart', [
				response && response.fragments ? response.fragments : {},
				response && response.cart_hash ? response.cart_hash : '',
				window.jQuery(cta),
			]);
		}

		document.body.dispatchEvent(new window.CustomEvent('wc-blocks_added_to_cart', {
			bubbles: true,
			detail: { preserveCartData: false },
		}));
	}

	var cartBadgeSyncId = 0;

	function cartApiEndpoint() {
		var apiRoot = window.wpApiSettings && window.wpApiSettings.root;

		if (apiRoot) {
			return apiRoot.replace(/\/?$/, '/') + 'wc/store/v1/cart';
		}

		return '/wp-json/wc/store/v1/cart';
	}

	function cartItemCount(cart) {
		if (!cart || !Array.isArray(cart.items)) {
			return 0;
		}

		return cart.items.reduce(function (total, item) {
			return total + Math.max(0, parseInt(item && item.quantity, 10) || 0);
		}, 0);
	}

	function cartItemCountFromFragments(response) {
		var fragments = response && response.fragments;
		var count = null;

		if (!fragments) {
			return count;
		}

		Object.keys(fragments).some(function (selector) {
			var wrapper = document.createElement('div');
			var rows;

			wrapper.innerHTML = fragments[selector];
			rows = Array.prototype.slice.call(wrapper.querySelectorAll('.woocommerce-mini-cart-item'));

			if (!rows.length && !wrapper.querySelector('.woocommerce-mini-cart__empty-message')) {
				return false;
			}

			count = rows.reduce(function (total, row) {
				var quantity = row.querySelector('.quantity');
				var match = quantity ? (quantity.textContent || '').match(/^\s*(\d+)/) : null;

				return total + (match ? parseInt(match[1], 10) : 1);
			}, 0);

			return true;
		});

		return count;
	}

	function updateHeaderCartBadge(quantity) {
		var safeQuantity = Math.max(0, parseInt(quantity, 10) || 0);
		var header = document.querySelector('.siini-site-header');
		var quantityBadges = Array.prototype.slice.call(document.querySelectorAll('.siini-site-header .wc-block-mini-cart__quantity-badge'));
		var badges = Array.prototype.slice.call(document.querySelectorAll('.siini-site-header .wc-block-mini-cart__badge'));

		quantityBadges.forEach(function (quantityBadge) {
			var badge = quantityBadge.querySelector('.wc-block-mini-cart__badge');

			if (badge) {
				return;
			}

			badge = document.createElement('span');
			badge.className = 'wc-block-mini-cart__badge';
			badge.setAttribute('aria-hidden', 'true');
			quantityBadge.appendChild(badge);
			badges.push(badge);
		});

		badges.forEach(function (badge) {
			badge.textContent = String(safeQuantity);
			badge.hidden = safeQuantity === 0;
		});

		if (header) {
			var fallback = header.querySelector('[data-siini-header-cart-fallback]');

			if (fallback) {
				fallback.classList.toggle('has-items', safeQuantity > 0);
			}
		}
	}

	function syncHeaderCartBadge(response) {
		var syncId = cartBadgeSyncId + 1;
		var fragmentCount = cartItemCountFromFragments(response);

		cartBadgeSyncId = syncId;
		if (fragmentCount !== null) {
			updateHeaderCartBadge(fragmentCount);
			return Promise.resolve();
		}

		return window.fetch(cartApiEndpoint(), {
			credentials: 'same-origin',
			headers: {
				'Cache-Control': 'no-cache',
			},
		}).then(function (response) {
			if (!response.ok) {
				throw new Error('cart-state-error');
			}

			return response.json();
		}).then(function (cart) {
			if (syncId === cartBadgeSyncId) {
				updateHeaderCartBadge(cartItemCount(cart));
			}
		}).catch(function () {
			// Woo Blocks still receives the add-to-cart event above as a fallback.
		});
	}

	function showAddedState(card) {
		var cta = card.querySelector('[data-siini-card-cta]');
		var added = card.querySelector('[data-siini-card-added]');
		var link = card.querySelector('[data-siini-card-added] a');
		var quantity = Math.max(0, parseInt(card.getAttribute('data-selected-quantity') || '0', 10) || 0) + 1;

		setCardQuantity(card, quantity);
		card.classList.add('is-added');
		Array.prototype.slice.call(card.querySelectorAll('.added_to_cart.wc-forward')).forEach(function (node) {
			node.remove();
		});

		if (link) {
			link.href = cartUrl();
		}

		if (cta) {
			cta.hidden = true;
			cta.classList.remove('is-loading');
		}

		if (added) {
			added.hidden = false;
		}
	}

	function setCardQuantity(card, quantity) {
		var safeQuantity = Math.max(1, parseInt(quantity, 10) || 1);
		var count = card.querySelector('[data-siini-card-added-count]');
		var minusButtons = Array.prototype.slice.call(card.querySelectorAll('[data-siini-card-qty-minus]'));

		card.setAttribute('data-selected-quantity', String(safeQuantity));

		if (count) {
			count.textContent = String(safeQuantity);
		}

		minusButtons.forEach(function (button) {
			button.disabled = safeQuantity <= 1;
			button.setAttribute('aria-disabled', safeQuantity <= 1 ? 'true' : 'false');
		});
	}

	function addToCart(card, cta, options) {
		var settings = options || {};
		var type = card.getAttribute('data-product-type') || cta.getAttribute('data-product-type') || '';
		var selected = selectedSize(card);
		var variationId = selected ? parseInt(selected.getAttribute('data-variation-id') || '0', 10) || 0 : 0;
		var productId = parseInt(card.getAttribute('data-product-id') || cta.getAttribute('data-product-id') || cta.getAttribute('data-product_id') || '0', 10) || 0;
		var body = new window.URLSearchParams();
		var requestEndpoint;
		var requestOptions;

		if (type === 'variable' && !variationId) {
			requestSizeSelection(card);
			return Promise.reject(new Error('missing-size'));
		}

		body.set('product_id', String(productId));
		body.set('quantity', '1');

		if (variationId) {
			body.set('variation_id', String(variationId));
		}

		if (selected && selected.getAttribute('data-attribute-name')) {
			body.set(selected.getAttribute('data-attribute-name'), selected.getAttribute('data-attribute-value') || '');
		}

		if (config().favoriteCartAction) {
			body.set('action', config().favoriteCartAction);
		}

		cta.classList.add('is-loading');
		cta.setAttribute('aria-busy', 'true');
		card.classList.add('is-quantity-loading');
		setMessage(card, '', false);

		requestEndpoint = favoriteCartEndpoint();
		requestOptions = {
			method: 'POST',
			credentials: 'same-origin',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
				'X-Requested-With': 'XMLHttpRequest',
			},
			body: body.toString(),
		};

		return window.fetch(requestEndpoint, requestOptions).then(function (response) {
			return response.json();
		}).then(function (response) {
			if (response && response.error) {
				throw new Error('add-to-cart-error');
			}

			applyFragments(response);
			dispatchCartEvents(response, cta);
			return syncHeaderCartBadge(response).then(function () {
				if (!settings.skipAddedState) {
					showAddedState(card);
				}
				setMessage(card, '', false);
				return response;
			});
		}).catch(function (error) {
			if (error && error.message === 'missing-size') {
				throw error;
			}

			cta.classList.remove('is-loading');
			card.classList.remove('is-quantity-loading');
			if (settings.silentError) {
				setMessage(card, '', false);
				return null;
			}
			setMessage(card, (config().messages && config().messages.cartError) || 'Не получилось добавить. Попробуйте еще раз.', true);
			throw error;
		}).finally(function () {
			cta.removeAttribute('aria-busy');
			card.classList.remove('is-quantity-loading');
		});
	}

	function initCard(card) {
		if (card.getAttribute('data-siini-card-ready') === '1') {
			updateCtaForSelection(card);
			return;
		}

		card.setAttribute('data-siini-card-ready', '1');

		var cta = card.querySelector('[data-siini-card-cta]');
		var sizes = Array.prototype.slice.call(card.querySelectorAll('[data-siini-card-size]'));

		sizes.forEach(function (button) {
			button.addEventListener('click', function (event) {
				event.preventDefault();
				event.stopPropagation();
				setSelectedSize(card, sizes, button);
			});
		});

		autoSelectDefaultSize(card, sizes);

		if (cta) {
			cta.addEventListener('click', function (event) {
				var type = card.getAttribute('data-product-type') || cta.getAttribute('data-product-type') || '';

				if (cta.classList.contains('is-loading')) {
					event.preventDefault();
					return;
				}

				if (type !== 'variable' && !cta.classList.contains('ajax_add_to_cart')) {
					return;
				}

				event.preventDefault();
				addToCart(card, cta).catch(function () {});
			});
		}

		Array.prototype.slice.call(card.querySelectorAll('[data-siini-card-qty-plus]')).forEach(function (button) {
			button.addEventListener('click', function (event) {
				var current = parseInt(card.getAttribute('data-selected-quantity') || '1', 10) || 1;

				event.preventDefault();
				event.stopPropagation();

				if (!card.classList.contains('is-added') || card.classList.contains('is-quantity-loading') || !cta) {
					return;
				}

				setCardQuantity(card, current + 1);
				addToCart(card, cta, {
					silentError: true,
					skipAddedState: true,
				}).catch(function () {});
			});
		});

		Array.prototype.slice.call(card.querySelectorAll('[data-siini-card-qty-minus]')).forEach(function (button) {
			button.addEventListener('click', function (event) {
				var current = parseInt(card.getAttribute('data-selected-quantity') || '1', 10) || 1;

				event.preventDefault();
				event.stopPropagation();

				if (!card.classList.contains('is-added')) {
					return;
				}

				if (current <= 1) {
					setCardQuantity(card, 1);
					return;
				}

				setCardQuantity(card, current - 1);
			});
		});

		updateCtaForSelection(card);
	}

	function initProductCards(root) {
		var scope = root && root.querySelectorAll ? root : document;

		Array.prototype.slice.call(scope.querySelectorAll('[data-siini-product-card]')).forEach(initCard);
	}

	window.siiniInitProductCards = initProductCards;

	ready(function () {
		initProductCards(document);
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var modal = document.createElement('div');
		var dialog = document.createElement('div');
		var closeButton = document.createElement('button');
		var image = null;
		var previousActive = null;

		modal.className = 'siini-product-lightbox';
		modal.setAttribute('data-siini-product-lightbox', '');
		modal.setAttribute('role', 'presentation');
		modal.hidden = true;

		dialog.className = 'siini-product-lightbox__dialog';
		dialog.setAttribute('role', 'dialog');
		dialog.setAttribute('aria-modal', 'true');
		dialog.setAttribute('aria-label', 'Фото товара');

		closeButton.className = 'siini-product-lightbox__close';
		closeButton.type = 'button';
		closeButton.setAttribute('aria-label', 'Закрыть фото');
		closeButton.textContent = '×';

		dialog.appendChild(closeButton);
		modal.appendChild(dialog);
		document.body.appendChild(modal);

		function ensureImage() {
			if (image) {
				return image;
			}

			image = document.createElement('img');
			image.className = 'siini-product-lightbox__image';
			image.alt = '';
			image.draggable = false;
			dialog.appendChild(image);
			return image;
		}

		function resetImage() {
			if (!image) {
				return;
			}

			image.removeAttribute('src');
			image.alt = '';
			image.remove();
			image = null;
		}

		function closeLightbox() {
			modal.hidden = true;
			resetImage();
			document.documentElement.classList.remove('siini-lightbox-open');
			document.body.classList.remove('siini-lightbox-open');

			if (previousActive && typeof previousActive.focus === 'function') {
				previousActive.focus({ preventScroll: true });
			}
		}

		function openLightbox(trigger) {
			var lightboxImage;
			var src = trigger.getAttribute('data-siini-card-lightbox-src') || '';

			if (!src) {
				return;
			}

			previousActive = document.activeElement;
			lightboxImage = ensureImage();
			lightboxImage.src = src;
			lightboxImage.alt = trigger.getAttribute('data-siini-card-lightbox-alt') || '';
			modal.hidden = false;
			document.documentElement.classList.add('siini-lightbox-open');
			document.body.classList.add('siini-lightbox-open');
			closeButton.focus({ preventScroll: true });
		}

		document.addEventListener('click', function (event) {
			var trigger = event.target.closest('[data-siini-card-lightbox]');

			if (!trigger) {
				return;
			}

			event.preventDefault();
			event.stopPropagation();
			openLightbox(trigger);
		});

		closeButton.addEventListener('click', function () {
			closeLightbox();
		});

		modal.addEventListener('click', function (event) {
			if (event.target === modal) {
				closeLightbox();
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape' && !modal.hidden) {
				closeLightbox();
			}
		});
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var mobileMenu = document.querySelector('[data-siini-mobile-menu], .siini-mobile-menu');
		var copyButtons = Array.prototype.slice.call(document.querySelectorAll('[data-siini-copy-code]'));
		var newsletterDemo = document.querySelector('[data-siini-newsletter-demo]');

		if (mobileMenu) {
			var mobileSummary = mobileMenu.querySelector(':scope > summary');
			var mobileSections = Array.prototype.slice.call(mobileMenu.querySelectorAll('[data-siini-mobile-section]'));
			var siteHeader = mobileMenu.closest('.siini-site-header');

			function syncMobileDrawerTop() {
				if (!mobileMenu.open || !siteHeader) {
					return;
				}

				mobileMenu.style.setProperty('--siini-mobile-drawer-top', Math.max(0, Math.round(siteHeader.getBoundingClientRect().bottom)) + 'px');
			}

			function closeMobileMenu(restoreFocus) {
				mobileMenu.open = false;
				mobileSections.forEach(function (section) {
					section.open = false;
				});

				if (restoreFocus && mobileSummary) {
					mobileSummary.focus({ preventScroll: true });
				}
			}

			mobileMenu.addEventListener('toggle', function () {
				document.documentElement.classList.toggle('siini-mobile-menu-open', mobileMenu.open);
				if (mobileSummary) {
					mobileSummary.setAttribute('aria-label', mobileMenu.open ? 'Закрыть меню' : 'Открыть меню');
				}

				if (mobileMenu.open) {
					syncMobileDrawerTop();
				} else {
					mobileMenu.style.removeProperty('--siini-mobile-drawer-top');
				}
			});

			Array.prototype.slice.call(mobileMenu.querySelectorAll('a')).forEach(function (link) {
				link.addEventListener('click', function () {
					closeMobileMenu(false);
				});
			});

			mobileSections.forEach(function (section) {
				section.addEventListener('toggle', function () {
					if (!section.open) {
						return;
					}

					mobileSections.forEach(function (otherSection) {
						if (otherSection !== section) {
							otherSection.open = false;
						}
					});
				});
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && mobileMenu.open) {
					event.preventDefault();
					closeMobileMenu(true);
				}
			});

			window.addEventListener('resize', syncMobileDrawerTop, { passive: true });
			window.addEventListener('scroll', syncMobileDrawerTop, { passive: true });
		}

		copyButtons.forEach(function (button) {
			button.addEventListener('click', function () {
				var code = button.getAttribute('data-siini-copy-code') || button.textContent || '';
				var initialText = button.textContent;

				function done() {
					button.textContent = 'Скопировано';
					window.setTimeout(function () {
						button.textContent = initialText;
					}, 1400);
				}

				if (navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(code).then(done, done);
					return;
				}

				done();
			});
		});

		if (newsletterDemo) {
			newsletterDemo.addEventListener('submit', function (event) {
				var button = newsletterDemo.querySelector('button[type="submit"]');
				event.preventDefault();
				if (button) {
					button.textContent = '✓';
					window.setTimeout(function () {
						button.textContent = '→';
					}, 1400);
				}
			});
		}
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var sliders = Array.prototype.slice.call(document.querySelectorAll('[data-siini-hero-slider]'));
		var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		sliders.forEach(function (slider) {
			var slides = Array.prototype.slice.call(slider.querySelectorAll('[data-siini-hero-slide]'));
			var dots = Array.prototype.slice.call(slider.querySelectorAll('[data-siini-hero-dot]'));
			var prevButton = slider.querySelector('[data-siini-hero-prev]');
			var nextButton = slider.querySelector('[data-siini-hero-next]');
			var activeIndex = 0;
			var timer = 0;
			var paused = false;
			var dragStartX = 0;
			var dragStartY = 0;
			var isDragging = false;

			if (slides.length <= 1) {
				if (prevButton) {
					prevButton.disabled = true;
				}
				if (nextButton) {
					nextButton.disabled = true;
				}
				return;
			}

			function show(nextIndex) {
				activeIndex = (nextIndex + slides.length) % slides.length;

				slides.forEach(function (slide, index) {
					var isActive = index === activeIndex;
					slide.classList.toggle('is-active', isActive);
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				});

				dots.forEach(function (dot, index) {
					var isActive = index === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
			}

			function stopTimer() {
				if (timer) {
					window.clearInterval(timer);
					timer = 0;
				}
			}

			function startTimer() {
				if (prefersReducedMotion || timer) {
					return;
				}

				timer = window.setInterval(function () {
					if (!paused) {
						show(activeIndex + 1);
					}
				}, 7200);
			}

			function manual(nextIndex) {
				stopTimer();
				show(nextIndex);
				window.setTimeout(startTimer, 9000);
			}

			if (prevButton) {
				prevButton.addEventListener('click', function () {
					manual(activeIndex - 1);
				});
			}

			if (nextButton) {
				nextButton.addEventListener('click', function () {
					manual(activeIndex + 1);
				});
			}

			dots.forEach(function (dot, index) {
				dot.addEventListener('click', function () {
					manual(index);
				});
			});

			slider.addEventListener('pointerenter', function () {
				paused = true;
			});

			slider.addEventListener('pointerleave', function () {
				paused = false;
			});

			slider.addEventListener('focusin', function () {
				paused = true;
			});

			slider.addEventListener('focusout', function () {
				paused = false;
			});

			show(0);
			startTimer();
		});
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var roots = Array.prototype.slice.call(document.querySelectorAll('[data-siini-review-carousel]'));
		var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		roots.forEach(function (root) {
			var slides = Array.prototype.slice.call(root.querySelectorAll('[data-siini-review-slide]'));
			var dots = Array.prototype.slice.call(root.querySelectorAll('[data-siini-review-dot]'));
			var prev = root.querySelector('[data-siini-review-prev]');
			var next = root.querySelector('[data-siini-review-next]');
			var progress = root.querySelector('[data-siini-review-progress]');
			var moreButtons = Array.prototype.slice.call(root.querySelectorAll('[data-siini-review-more]'));
			var activeIndex = 0;
			var timer = 0;
			var restartTimer = 0;
			var paused = false;
			var isDragging = false;
			var dragStartX = 0;
			var dragStartY = 0;

			if (slides.length <= 1) {
				if (prev) {
					prev.disabled = true;
				}
				if (next) {
					next.disabled = true;
				}
				return;
			}

			function show(index) {
				activeIndex = (index + slides.length) % slides.length;

				slides.forEach(function (slide, slideIndex) {
					var isActive = slideIndex === activeIndex;
					var isPrev = slideIndex === (activeIndex - 1 + slides.length) % slides.length;
					var isNext = slideIndex === (activeIndex + 1) % slides.length;
					var isPrevTwo = slideIndex === (activeIndex - 2 + slides.length) % slides.length;
					var isNextTwo = slideIndex === (activeIndex + 2) % slides.length;

					slide.classList.toggle('is-active', isActive);
					slide.classList.toggle('is-prev', isPrev);
					slide.classList.toggle('is-next', isNext);
					slide.classList.toggle('is-prev-two', isPrevTwo);
					slide.classList.toggle('is-next-two', isNextTwo);
					slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
				});

				dots.forEach(function (dot, dotIndex) {
					var isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
					dot.setAttribute('tabindex', isActive ? '0' : '-1');
				});

				moreButtons.forEach(function (button) {
					var slide = button.closest('[data-siini-review-slide]');
					button.tabIndex = slide && slide.classList.contains('is-active') ? 0 : -1;
				});

				if (progress) {
					progress.style.width = (((activeIndex + 1) / slides.length) * 100).toFixed(2) + '%';
				}
			}

			function stopTimer() {
				if (timer) {
					window.clearInterval(timer);
					timer = 0;
				}
			}

			function startTimer() {
				if (prefersReducedMotion || timer) {
					return;
				}

				timer = window.setInterval(function () {
					if (!paused) {
						show(activeIndex + 1);
					}
				}, 6200);
			}

			function manual(index) {
				stopTimer();
				if (restartTimer) {
					window.clearTimeout(restartTimer);
					restartTimer = 0;
				}
				show(index);
				restartTimer = window.setTimeout(function () {
					restartTimer = 0;
					startTimer();
				}, 8000);
			}

			function isInteractiveTarget(target) {
				return target && target.closest && root.contains(target) && Boolean(target.closest('button, a, input, select, textarea, [role="button"]'));
			}

			root.addEventListener('click', function (event) {
				var target = event.target;
				var arrow = target && target.closest ? target.closest('[data-siini-review-prev], [data-siini-review-next]') : null;

				if (!arrow || !root.contains(arrow)) {
					return;
				}

				event.preventDefault();
				manual(arrow.hasAttribute('data-siini-review-prev') ? activeIndex - 1 : activeIndex + 1);
			});

			dots.forEach(function (dot, dotIndex) {
				dot.addEventListener('click', function () {
					manual(dotIndex);
				});
			});

			moreButtons.forEach(function (button) {
				button.addEventListener('click', function () {
					var slide = button.closest('[data-siini-review-slide]');
					var isExpanded;

					if (!slide) {
						return;
					}

					isExpanded = !slide.classList.contains('is-expanded');
					slide.classList.toggle('is-expanded', isExpanded);
					button.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
					button.textContent = isExpanded ? 'Свернуть' : 'Читать полностью';
				});
			});

			root.addEventListener('pointerenter', function () {
				paused = true;
			});

			root.addEventListener('pointerleave', function () {
				if (!isDragging) {
					paused = false;
				}
			});

			root.addEventListener('focusin', function () {
				paused = true;
			});

			root.addEventListener('focusout', function (event) {
				if (!event.relatedTarget || !root.contains(event.relatedTarget)) {
					paused = false;
				}
			});

			root.addEventListener('pointerdown', function (event) {
				if (event.pointerType === 'mouse' && event.button !== 0) {
					return;
				}

				if (isInteractiveTarget(event.target)) {
					return;
				}

				dragStartX = event.clientX;
				dragStartY = event.clientY;
				isDragging = true;
				paused = true;
				if (root.setPointerCapture && event.pointerId) {
					try {
						root.setPointerCapture(event.pointerId);
					} catch (error) {
						// Pointer capture is a best-effort polish for drag continuity.
					}
				}
			});

			root.addEventListener('pointerup', function (event) {
				if (!isDragging) {
					return;
				}

				var diffX = event.clientX - dragStartX;
				var diffY = event.clientY - dragStartY;
				isDragging = false;
				paused = false;

				if (Math.abs(diffX) < 44 || Math.abs(diffX) < Math.abs(diffY)) {
					return;
				}

				manual(diffX < 0 ? activeIndex + 1 : activeIndex - 1);
			});

			root.addEventListener('pointercancel', function () {
				isDragging = false;
				paused = false;
			});

			root.addEventListener('keydown', function (event) {
				if (event.key === 'ArrowLeft') {
					event.preventDefault();
					manual(activeIndex - 1);
				} else if (event.key === 'ArrowRight') {
					event.preventDefault();
					manual(activeIndex + 1);
				} else if (event.key === 'Home') {
					event.preventDefault();
					manual(0);
				} else if (event.key === 'End') {
					event.preventDefault();
					manual(slides.length - 1);
				}
			});

			show(0);
			startTimer();
		});
	});
}());

(function () {
	'use strict';

	if (!window.matchMedia || !document.body) {
		return;
	}

	var supportsFinePointer = window.matchMedia('(pointer: fine)').matches;
	var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!supportsFinePointer || prefersReducedMotion) {
		return;
	}

	var dot = document.createElement('div');
	dot.className = 'siini-cursor-dot';
	dot.setAttribute('aria-hidden', 'true');
	document.body.appendChild(dot);

	var raf = 0;
	var targetX = 0;
	var targetY = 0;

	function paint() {
		dot.style.transform = 'translate3d(' + targetX + 'px, ' + targetY + 'px, 0) translate(-50%, -50%)';
		raf = 0;
	}

	window.addEventListener('pointermove', function (event) {
		targetX = event.clientX;
		targetY = event.clientY;
		dot.classList.add('is-visible');

		if (!raf) {
			raf = window.requestAnimationFrame(paint);
		}
	}, { passive: true });

	window.addEventListener('pointerleave', function () {
		dot.classList.remove('is-visible');
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var items = Array.prototype.slice.call(document.querySelectorAll('[data-siini-mega-item]'));
		var closeTimer = 0;

		if (!items.length) {
			return;
		}

		function setExpanded(item, expanded) {
			var trigger = item.querySelector('.siini-mega-nav__trigger');
			var panel = item.querySelector('[data-siini-mega-panel]');
			item.classList.toggle('is-open', expanded);
			if (!expanded) {
				item.classList.remove('is-click-open');
			}
			if (trigger) {
				trigger.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			}
			if (panel) {
				panel.hidden = !expanded;
			}
		}

		function closeAll(except) {
			items.forEach(function (item) {
				if (item !== except) {
					setExpanded(item, false);
				}
			});
		}

		function openItem(item) {
			window.clearTimeout(closeTimer);
			closeAll(item);
			setExpanded(item, true);
		}

		function queueClose(item, force) {
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(function () {
				if (!force && item.classList.contains('is-click-open')) {
					return;
				}
				setExpanded(item, false);
			}, 160);
		}

		items.forEach(function (item) {
			var trigger = item.querySelector('.siini-mega-nav__trigger');

			item.addEventListener('pointerenter', function (event) {
				if (event.pointerType === 'touch') {
					return;
				}
				openItem(item);
			});

			item.addEventListener('pointerleave', function (event) {
				if (event.pointerType === 'touch') {
					return;
				}
				queueClose(item, false);
			});

			item.addEventListener('focusin', function () {
				openItem(item);
			});

			item.addEventListener('focusout', function (event) {
				if (!item.contains(event.relatedTarget)) {
					queueClose(item, true);
				}
			});

			if (trigger) {
				trigger.addEventListener('click', function () {
					if (item.classList.contains('is-click-open')) {
						setExpanded(item, false);
						return;
					}

					openItem(item);
					item.classList.add('is-click-open');
				});
			}
		});

		document.addEventListener('pointerdown', function (event) {
			if (!event.target.closest('[data-siini-mega-item]')) {
				window.clearTimeout(closeTimer);
				closeAll(null);
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') {
				var openItemElement = items.find(function (item) {
					return item.classList.contains('is-open');
				});
				var trigger = openItemElement ? openItemElement.querySelector('.siini-mega-nav__trigger') : null;
				window.clearTimeout(closeTimer);
				closeAll(null);
				if (trigger) {
					trigger.focus({ preventScroll: true });
				}
			}
		});
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var details = document.querySelector('[data-siini-catalog-filters-details]');
		if (!details || !window.matchMedia) {
			return;
		}

		var desktopQuery = window.matchMedia('(min-width: 901px)');

		function sync() {
			details.open = desktopQuery.matches;
		}

		sync();

		if (desktopQuery.addEventListener) {
			desktopQuery.addEventListener('change', sync);
		} else if (desktopQuery.addListener) {
			desktopQuery.addListener(sync);
		}

		window.addEventListener('pageshow', sync);
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var roots = Array.prototype.slice.call(document.querySelectorAll('[data-siini-catalog-filters]'));
		var activeRoot = null;
		var mobileQuery = window.matchMedia ? window.matchMedia('(max-width: 900px)') : null;
		var focusRestoreKey = 'siiniCatalogFilterRestoreFocus';

		function initBrandSearch(root) {
			var section = root.querySelector('.siini-filter-section--brand');
			var input = section ? section.querySelector('[data-siini-brand-search-input]') : null;
			var empty = section ? section.querySelector('[data-siini-brand-search-empty]') : null;
			var options = section ? Array.prototype.slice.call(section.querySelectorAll('.siini-filter-option')) : [];

			if (!input || !options.length) {
				return;
			}

			function normalize(value) {
				return String(value || '').trim().toLocaleLowerCase('ru-RU');
			}

			function filterOptions() {
				var query = normalize(input.value);
				var visibleCount = 0;

				options.forEach(function (option) {
					var title = option.querySelector('b');
					var matches = query === '' || normalize(title ? title.textContent : option.textContent).indexOf(query) !== -1;

					option.hidden = !matches;
					if (matches) {
						visibleCount += 1;
					}
				});

				if (empty) {
					empty.hidden = visibleCount > 0;
				}
			}

			input.addEventListener('input', filterOptions);
			input.addEventListener('search', filterOptions);
			filterOptions();
		}

		function initPriceSlider(root) {
			var slider = root.querySelector('[data-siini-price-slider]');
			if (!slider) {
				return;
			}

			var minRange = slider.querySelector('[data-siini-price-min]');
			var maxRange = slider.querySelector('[data-siini-price-max]');
			var minInput = root.querySelector('input[name="min_price"]');
			var maxInput = root.querySelector('input[name="max_price"]');
			var min = Number(slider.getAttribute('data-min') || 0);
			var max = Number(slider.getAttribute('data-max') || 50000);

			if (!minRange || !maxRange || !minInput || !maxInput) {
				return;
			}

			function clamp(value, fallback) {
				value = Number(value);
				if (!Number.isFinite(value)) {
					return fallback;
				}

				return Math.min(max, Math.max(min, value));
			}

			function inputValue(input, fallback) {
				return input.value.trim() === '' ? fallback : clamp(input.value, fallback);
			}

			function paint() {
				var minValue = clamp(minRange.value, min);
				var maxValue = clamp(maxRange.value, max);
				var minPercent = ((minValue - min) / (max - min)) * 100;
				var maxPercent = ((maxValue - min) / (max - min)) * 100;

				slider.style.setProperty('--siini-price-min', minPercent + '%');
				slider.style.setProperty('--siini-price-max', maxPercent + '%');
			}

			function syncFromRanges(changed) {
				var minValue = clamp(minRange.value, min);
				var maxValue = clamp(maxRange.value, max);

				if (minValue > maxValue) {
					if (changed === maxRange) {
						minValue = maxValue;
						minRange.value = String(minValue);
					} else {
						maxValue = minValue;
						maxRange.value = String(maxValue);
					}
				}

				minInput.value = minValue <= min ? '' : String(Math.round(minValue));
				maxInput.value = maxValue >= max ? '' : String(Math.round(maxValue));
				paint();
			}

			function syncFromInputs() {
				var minValue = inputValue(minInput, min);
				var maxValue = inputValue(maxInput, max);

				if (minValue > maxValue) {
					maxValue = minValue;
				}

				minRange.value = String(minValue);
				maxRange.value = String(maxValue);
				paint();
			}

			minRange.addEventListener('input', function () {
				syncFromRanges(minRange);
			});
			maxRange.addEventListener('input', function () {
				syncFromRanges(maxRange);
			});
			minInput.addEventListener('input', syncFromInputs);
			maxInput.addEventListener('input', syncFromInputs);
			syncFromInputs();
		}

		function syncClosedState(root) {
			var panel = root.querySelector('.siini-catalog-filters__panel');
			var backdrop = root.querySelector('.siini-catalog-filters__backdrop');
			var isMobile = mobileQuery ? mobileQuery.matches : window.innerWidth <= 900;
			var isOpen = root.classList.contains('is-open');

			if (panel) {
				if (isMobile) {
					panel.hidden = !isOpen;
					panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
					if (isOpen) {
						panel.removeAttribute('inert');
					} else {
						panel.setAttribute('inert', '');
					}
					if ('inert' in panel) {
						panel.inert = !isOpen;
					}
				} else {
					panel.hidden = false;
					panel.setAttribute('aria-hidden', 'false');
					panel.removeAttribute('inert');
					if ('inert' in panel) {
						panel.inert = false;
					}
				}
			}

			if (backdrop) {
				backdrop.hidden = isMobile ? !isOpen : true;
				backdrop.setAttribute('aria-hidden', isOpen && isMobile ? 'false' : 'true');
				if (isOpen && isMobile) {
					backdrop.removeAttribute('inert');
				} else {
					backdrop.setAttribute('inert', '');
				}
				if ('inert' in backdrop) {
					backdrop.inert = !(isOpen && isMobile);
				}
			}

			if (!isOpen || !isMobile) {
				document.body.classList.remove('siini-filter-drawer-open');
			}
		}

		function firstFocusableInPanel(root) {
			var panel = root.querySelector('.siini-catalog-filters__panel');

			if (!panel) {
				return null;
			}

			return panel.querySelector('[data-siini-filter-close], input:not([disabled]), button:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href]');
		}

		function rememberFocusRestore() {
			try {
				window.sessionStorage.setItem(focusRestoreKey, '1');
			} catch (error) {}
		}

		function restoreFocusIfNeeded(root) {
			var opener;
			var shouldRestore = false;

			try {
				shouldRestore = window.sessionStorage.getItem(focusRestoreKey) === '1';
			} catch (error) {}

			if (!shouldRestore) {
				return;
			}

			opener = root.querySelector('[data-siini-filter-open]');
			if (opener && typeof opener.focus === 'function') {
				window.setTimeout(function () {
					opener.focus({ preventScroll: true });
				}, 40);
			}

			try {
				window.sessionStorage.removeItem(focusRestoreKey);
			} catch (error) {}
		}

		function setOpen(root, open, options) {
			var opener = root.querySelector('[data-siini-filter-open]');
			var focusTarget;
			var isMobile = mobileQuery ? mobileQuery.matches : window.innerWidth <= 900;

			options = options || {};

			root.classList.toggle('is-open', open);
			document.body.classList.toggle('siini-filter-drawer-open', open && isMobile);

			if (opener) {
				opener.setAttribute('aria-expanded', open ? 'true' : 'false');
			}

			syncClosedState(root);

			if (open) {
				activeRoot = root;
				window.setTimeout(function () {
					focusTarget = firstFocusableInPanel(root);
					if (focusTarget && typeof focusTarget.focus === 'function') {
						focusTarget.focus({ preventScroll: true });
					}
				}, 40);
			} else if (activeRoot === root) {
				activeRoot = null;
				if (options.rememberFocus) {
					rememberFocusRestore();
				}
				if (options.returnFocus !== false && opener) {
					opener.focus({ preventScroll: true });
				}
			}
		}

		roots.forEach(function (root) {
			var opener = root.querySelector('[data-siini-filter-open]');
			var form = root.querySelector('.siini-catalog-filters__form');
			initBrandSearch(root);
			initPriceSlider(root);
			syncClosedState(root);
			restoreFocusIfNeeded(root);

			if (opener) {
				opener.addEventListener('click', function () {
					setOpen(root, !root.classList.contains('is-open'));
				});
			}

			Array.prototype.slice.call(root.querySelectorAll('[data-siini-filter-close]')).forEach(function (button) {
				button.addEventListener('click', function () {
					setOpen(root, false);
				});
			});

			if (form) {
				form.addEventListener('submit', function () {
					setOpen(root, false, { rememberFocus: true, returnFocus: false });
				});
			}

			Array.prototype.slice.call(root.querySelectorAll('input[type="radio"], input[type="checkbox"]')).forEach(function (input) {
				input.addEventListener('change', function () {
					var name = input.name;
					if (input.type === 'radio' && name) {
						Array.prototype.slice.call(root.querySelectorAll('input[name="' + name.replace(/"/g, '\\"') + '"]')).forEach(function (option) {
							if (option.closest('label')) {
								option.closest('label').classList.toggle('is-active', option.checked);
							}
						});
						return;
					}

					if (input.closest('label')) {
						input.closest('label').classList.toggle('is-active', input.checked);
					}
				});
			});
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape' && activeRoot) {
				setOpen(activeRoot, false);
			}
		});

		document.addEventListener('click', function (event) {
			var closeTrigger = event.target.closest('[data-siini-filter-close]');
			if (!closeTrigger) {
				return;
			}

			var root = closeTrigger.closest('[data-siini-catalog-filters]');
			if (root) {
				setOpen(root, false);
			}
		});

		if (mobileQuery) {
			var syncAll = function () {
				roots.forEach(function (root) {
					if (!mobileQuery.matches) {
						root.classList.remove('is-open');
					}
					syncClosedState(root);
					restoreFocusIfNeeded(root);
				});
			};

			if (mobileQuery.addEventListener) {
				mobileQuery.addEventListener('change', syncAll);
			} else if (mobileQuery.addListener) {
				mobileQuery.addListener(syncAll);
			}

			window.addEventListener('pageshow', syncAll);
		}
	});
}());

(function () {
	'use strict';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	ready(function () {
		var panel = document.querySelector('[data-siini-search-panel]');
		var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-siini-search-open]'));
		var input = panel ? panel.querySelector('[data-siini-search-input]') : null;
		var form = panel ? panel.querySelector('form') : null;
		var lastTrigger = null;

		document.documentElement.classList.remove('siini-search-open');
		if (document.body) {
			document.body.classList.remove('siini-search-open');
		}

		if (!panel || !triggers.length || !input || !form) {
			return;
		}

		if (!input.getAttribute('aria-label')) {
			input.setAttribute('aria-label', 'Поиск товаров');
		}

		function setExpanded(open) {
			triggers.forEach(function (trigger) {
				trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			});
		}

		function openSearch(event) {
			lastTrigger = event && event.currentTarget ? event.currentTarget : null;
			panel.hidden = false;
			document.body.classList.add('siini-search-open');
			document.documentElement.classList.add('siini-search-open');
			setExpanded(true);
			window.setTimeout(function () {
				input.focus({ preventScroll: true });
			}, 40);
		}

		function closeSearch() {
			panel.hidden = true;
			document.body.classList.remove('siini-search-open');
			document.documentElement.classList.remove('siini-search-open');
			setExpanded(false);
			if (lastTrigger && typeof lastTrigger.focus === 'function') {
				lastTrigger.focus({ preventScroll: true });
			}
		}

		function clearSearchLock() {
			panel.hidden = true;
			document.body.classList.remove('siini-search-open');
			document.documentElement.classList.remove('siini-search-open');
			setExpanded(false);
		}

		function submitSearch(event) {
			var query = input.value.trim();

			if (query === '') {
				event.preventDefault();
				input.focus();
				return;
			}

			event.preventDefault();
			input.value = query;
			clearSearchLock();
			window.location.assign('/?s=' + encodeURIComponent(query) + '&post_type=product');
		}

		triggers.forEach(function (trigger) {
			trigger.addEventListener('click', openSearch);
		});

		Array.prototype.slice.call(panel.querySelectorAll('[data-siini-search-close]')).forEach(function (button) {
			button.addEventListener('click', closeSearch);
		});

		form.addEventListener('submit', submitSearch);

		input.addEventListener('keydown', function (event) {
			if (event.key === 'Enter') {
				submitSearch(event);
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape' && !panel.hidden) {
				closeSearch();
			}
		});

		window.addEventListener('pagehide', clearSearchLock);
		window.addEventListener('pageshow', clearSearchLock);
		document.addEventListener('DOMContentLoaded', clearSearchLock);
		clearSearchLock();
	});
}());

(function () {
	'use strict';

	var revealObserver = null;
	var resizeTimer = 0;

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function prefersReducedMotion() {
		return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function catalogShells() {
		return Array.prototype.slice.call(document.querySelectorAll('.siini-catalog-product-shell'));
	}

	function catalogGrids() {
		return Array.prototype.slice.call(document.querySelectorAll([
			'.siini-catalog-product-shell [data-siini-catalog-grid] .siini-home-product-grid--catalog',
			'.siini-catalog-product-shell .siini-home-product-grid--catalog',
			'.siini-catalog-product-shell .siini-catalog-grid ul.products'
		].join(', ')));
	}

	function cardsForGrid(grid) {
		if (grid.matches && grid.matches('ul.products')) {
			return Array.prototype.slice.call(grid.querySelectorAll('li.product'));
		}

		return Array.prototype.slice.call(grid.querySelectorAll('.siini-home-product-card--catalog'));
	}

	function columnCount(grid, cards) {
		var styles = window.getComputedStyle ? window.getComputedStyle(grid) : null;
		var gap = styles ? parseFloat(styles.columnGap || styles.gap || '0') || 0 : 0;
		var gridWidth = grid.getBoundingClientRect().width;
		var cardWidth = cards[0] ? cards[0].getBoundingClientRect().width : 0;

		if (!gridWidth || !cardWidth) {
			return 1;
		}

		return Math.max(1, Math.round((gridWidth + gap) / (cardWidth + gap)));
	}

	function revealDelay(index, columns) {
		var isMobile = window.matchMedia && window.matchMedia('(max-width: 600px)').matches;
		var steps = Math.max(1, Math.min(columns, isMobile ? 2 : 4));

		return (index % steps) * (isMobile ? 50 : 70);
	}

	function showImmediately(cards) {
		document.documentElement.classList.remove('siini-product-reveal-ready');
		cards.forEach(function (card) {
			card.classList.add('is-visible');
			card.style.setProperty('--siini-reveal-delay', '0ms');
		});
	}

	function createObserver() {
		if (revealObserver || !('IntersectionObserver' in window)) {
			return revealObserver;
		}

		revealObserver = new window.IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (!entry.isIntersecting && entry.intersectionRatio <= 0) {
					return;
				}

				entry.target.classList.add('is-visible');
				entry.target.removeAttribute('data-siini-product-reveal-observed');
				revealObserver.unobserve(entry.target);
			});
		}, {
			rootMargin: '0px 0px -8% 0px',
			threshold: 0.12
		});

		return revealObserver;
	}

	function initProductReveal() {
		var grids = catalogGrids();
		var allCards = [];
		var observer;

		if (!grids.length) {
			document.documentElement.classList.remove('siini-product-reveal-ready');
			return;
		}

		grids.forEach(function (grid) {
			var cards = cardsForGrid(grid);
			var columns = columnCount(grid, cards);

			cards.forEach(function (card, index) {
				card.classList.add('siini-product-reveal');
				card.setAttribute('data-siini-product-reveal', '');
				card.style.setProperty('--siini-reveal-delay', revealDelay(index, columns) + 'ms');
				allCards.push(card);
			});
		});

		if (!allCards.length) {
			return;
		}

		if (prefersReducedMotion() || !('IntersectionObserver' in window)) {
			showImmediately(allCards);
			return;
		}

		document.documentElement.classList.add('siini-product-reveal-ready');
		observer = createObserver();

		allCards.forEach(function (card) {
			if (card.classList.contains('is-visible') || card.getAttribute('data-siini-product-reveal-observed') === '1') {
				return;
			}

			card.setAttribute('data-siini-product-reveal-observed', '1');
			observer.observe(card);
		});
	}

	function observeCatalogChanges() {
		if (!('MutationObserver' in window)) {
			return;
		}

		catalogShells().forEach(function (shell) {
			if (shell.getAttribute('data-siini-product-reveal-mutations') === '1') {
				return;
			}

			shell.setAttribute('data-siini-product-reveal-mutations', '1');
			new window.MutationObserver(function (mutations) {
				var hasAddedNodes = mutations.some(function (mutation) {
					return mutation.addedNodes && mutation.addedNodes.length;
				});

				if (hasAddedNodes) {
					window.requestAnimationFrame(initProductReveal);
				}
			}).observe(shell, {
				childList: true,
				subtree: true
			});
		});
	}

	window.siiniInitProductReveal = initProductReveal;

	ready(function () {
		initProductReveal();
		observeCatalogChanges();

		window.addEventListener('resize', function () {
			window.clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(initProductReveal, 120);
		}, { passive: true });
	});
}());

(function () {
	'use strict';

	var STORAGE_KEY = 'siini_recently_viewed_v1';
	var MAX_ITEMS = 24;
	var TTL_MS = 30 * 24 * 60 * 60 * 1000;

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function browserStorage() {
		try {
			var testKey = STORAGE_KEY + '_test';
			window.localStorage.setItem(testKey, '1');
			window.localStorage.removeItem(testKey);
			return window.localStorage;
		} catch (error) {
			return null;
		}
	}

	function productId(value) {
		var normalized = String(value || '').trim();

		if (!/^[1-9]\d*$/.test(normalized)) {
			return 0;
		}

		return parseInt(normalized, 10) || 0;
	}

	function normalizedItems(payload, now) {
		var source = payload && payload.version === 1 && Array.isArray(payload.items) ? payload.items : [];
		var byId = {};

		source.forEach(function (item) {
			var id = productId(item && item.id);
			var viewedAt = Number(item && item.viewedAt);

			if (!id || !isFinite(viewedAt) || viewedAt <= now - TTL_MS || viewedAt > now + TTL_MS) {
				return;
			}

			if (!byId[id] || byId[id].viewedAt < viewedAt) {
				byId[id] = { id: id, viewedAt: viewedAt };
			}
		});

		return Object.keys(byId).map(function (id) {
			return byId[id];
		}).sort(function (left, right) {
			return right.viewedAt - left.viewedAt;
		}).slice(0, MAX_ITEMS);
	}

	function readHistory(store) {
		var raw;
		var parsed;

		if (!store) {
			return [];
		}

		try {
			raw = store.getItem(STORAGE_KEY);
			parsed = raw ? JSON.parse(raw) : null;
			return normalizedItems(parsed, Date.now());
		} catch (error) {
			try {
				store.removeItem(STORAGE_KEY);
			} catch (removeError) {}
			return [];
		}
	}

	function writeHistory(store, items) {
		if (!store) {
			return;
		}

		try {
			store.setItem(STORAGE_KEY, JSON.stringify({
				version: 1,
				items: items.slice(0, MAX_ITEMS),
			}));
		} catch (error) {}
	}

	function candidatesForCurrentProduct(currentId) {
		var store = browserStorage();
		var history = readHistory(store);
		var candidates = history.filter(function (item) {
			return item.id !== currentId;
		});

		writeHistory(store, [{ id: currentId, viewedAt: Date.now() }].concat(candidates));

		return candidates.slice(0, MAX_ITEMS).map(function (item) {
			return item.id;
		});
	}

	function hideSection(section) {
		var grid = section.querySelector('[data-siini-recently-viewed-grid]');

		if (grid) {
			grid.innerHTML = '';
		}

		section.hidden = true;
	}

	function endpoint() {
		return (window.siiniSite && window.siiniSite.recentlyViewedEndpoint) || '';
	}

	function hydrateSection(section, ids) {
		var grid = section.querySelector('[data-siini-recently-viewed-grid]');
		var currentId = productId(section.getAttribute('data-current-product-id'));
		var requestId;
		var url;

		hideSection(section);
		if (!grid || !currentId || !window.fetch || !endpoint()) {
			return;
		}

		requestId = (parseInt(section.getAttribute('data-siini-recently-viewed-request') || '0', 10) || 0) + 1;
		section.setAttribute('data-siini-recently-viewed-request', String(requestId));
		url = endpoint() + (endpoint().indexOf('?') === -1 ? '?' : '&') + 'ids=' + encodeURIComponent(ids.join(',')) + '&current_id=' + encodeURIComponent(String(currentId));

		window.fetch(url, {
			credentials: 'same-origin',
			cache: 'no-store',
			headers: { Accept: 'application/json' },
		}).then(function (response) {
			if (!response.ok) {
				throw new Error('recently-viewed-response');
			}

			return response.json();
		}).then(function (payload) {
			if (
				section.getAttribute('data-siini-recently-viewed-request') !== String(requestId)
				|| !payload
				|| !payload.ok
				|| typeof payload.cards !== 'string'
				|| payload.cards === ''
			) {
				return;
			}

			grid.innerHTML = payload.cards;
			section.hidden = false;

			if (typeof window.siiniInitProductCards === 'function') {
				window.siiniInitProductCards(grid);
			}

			if (typeof window.siiniSyncFavorites === 'function') {
				window.siiniSyncFavorites();
			}
		}).catch(function () {
			hideSection(section);
		});
	}

	function initializeRecentlyViewed() {
		Array.prototype.slice.call(document.querySelectorAll('[data-siini-recently-viewed]')).forEach(function (section) {
			var currentId = productId(section.getAttribute('data-current-product-id'));

			if (!currentId) {
				hideSection(section);
				return;
			}

			hydrateSection(section, candidatesForCurrentProduct(currentId));
		});
	}

	ready(initializeRecentlyViewed);

	window.addEventListener('pageshow', function (event) {
		if (event.persisted) {
			initializeRecentlyViewed();
		}
	});
}());

(function () {
	'use strict';

	var STORAGE_KEY = 'siini_catalog_infinite_feed_v1';

	function ready(callback) {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', callback);
			return;
		}

		callback();
	}

	function normalizeFeedKey() {
		var url;

		if (!window.URL || !window.URLSearchParams) {
			return window.location.href.replace(/([?&])product-page=\d+/g, '$1').replace(/[?&]$/, '');
		}

		url = new window.URL(window.location.href);
		url.searchParams.delete('product-page');
		return url.toString();
	}

	function storage() {
		try {
			var testKey = STORAGE_KEY + '_test';
			window.sessionStorage.setItem(testKey, '1');
			window.sessionStorage.removeItem(testKey);
			return window.sessionStorage;
		} catch (error) {
			return null;
		}
	}

	function productGrid(feed) {
		return feed ? feed.querySelector('.siini-home-product-grid--catalog') : null;
	}

	function productCards(root) {
		return Array.prototype.slice.call((root || document).querySelectorAll('[data-siini-product-card]'));
	}

	function cardKey(card) {
		return String(card.getAttribute('data-product-id') || card.getAttribute('data-siini-favorite-url') || '');
	}

	function keysForGrid(grid) {
		var keys = {};

		productCards(grid).forEach(function (card) {
			var key = cardKey(card);
			if (key) {
				keys[key] = true;
			}
		});

		return keys;
	}

	function resetProductRuntimeState(root) {
		productCards(root).forEach(function (card) {
			card.removeAttribute('data-siini-card-ready');
		});
	}

	function setImagesLazy(root) {
		Array.prototype.slice.call(root.querySelectorAll('img')).forEach(function (image) {
			image.loading = 'lazy';
			image.decoding = 'async';
		});
	}

	function nextUrl(feed) {
		var explicit = feed.getAttribute('data-siini-next-url') || '';
		var nextLink = feed.querySelector('.siini-catalog-pagination a.next');

		return explicit || (nextLink ? nextLink.href : '');
	}

	function setFeedState(feed, state, message) {
		var status = feed.querySelector('[data-siini-infinite-state]');
		var text = feed.querySelector('[data-siini-infinite-message]');
		var retry = feed.querySelector('[data-siini-infinite-retry]');

		feed.setAttribute('data-siini-infinite-status', state);

		if (!status || !text) {
			return;
		}

		text.textContent = message || '';
		status.hidden = state === 'idle';
		status.classList.toggle('is-loading', state === 'loading');
		status.classList.toggle('is-error', state === 'error');
		status.classList.toggle('is-end', state === 'end');

		if (retry) {
			retry.hidden = state !== 'error';
		}
	}

	function callProductInitializers(root) {
		if (window.siiniInitProductCards) {
			window.siiniInitProductCards(root);
		}

		if (window.siiniSyncFavorites) {
			window.siiniSyncFavorites();
		}

		if (window.siiniInitProductReveal) {
			window.requestAnimationFrame(window.siiniInitProductReveal);
		}
	}

	function saveFeed(feed) {
		var store = storage();
		var grid = productGrid(feed);
		var payload;

		if (!store || !grid) {
			return;
		}

		payload = {
			key: normalizeFeedKey(),
			html: grid.innerHTML,
			nextUrl: nextUrl(feed),
			currentPage: feed.getAttribute('data-siini-current-page') || '1',
			maxPages: feed.getAttribute('data-siini-max-pages') || '1',
			ended: feed.getAttribute('data-siini-infinite-status') === 'end',
			scrollY: window.scrollY || window.pageYOffset || 0,
			timestamp: Date.now()
		};

		try {
			store.setItem(STORAGE_KEY, JSON.stringify(payload));
		} catch (error) {
			store.removeItem(STORAGE_KEY);
			}
		}

		function clearSavedFeed() {
			var store = storage();

			if (!store) {
				return;
			}

			try {
				store.removeItem(STORAGE_KEY);
			} catch (error) {}
		}

		function restoreFeed(feed) {
			var store = storage();
			var grid = productGrid(feed);
		var payload;

		if (!store || !grid) {
			return false;
		}

		try {
			payload = JSON.parse(store.getItem(STORAGE_KEY) || 'null');
		} catch (error) {
			payload = null;
		}

		if (!payload || payload.key !== normalizeFeedKey() || !payload.html || (Date.now() - payload.timestamp) > 30 * 60 * 1000) {
			return false;
		}

		grid.innerHTML = payload.html;
		resetProductRuntimeState(grid);
		feed.setAttribute('data-siini-next-url', payload.nextUrl || '');
		feed.setAttribute('data-siini-current-page', payload.currentPage || '1');
		feed.setAttribute('data-siini-max-pages', payload.maxPages || '1');
		callProductInitializers(grid);

		if (payload.ended || !payload.nextUrl) {
			setFeedState(feed, 'end', 'Вы посмотрели все товары');
		}

		window.requestAnimationFrame(function () {
			window.scrollTo(0, Math.max(0, parseInt(payload.scrollY || '0', 10) || 0));
		});

		return true;
	}

	function updatePaginationFromNextFeed(feed, nextFeed) {
		var pagination = feed.querySelector('.siini-catalog-pagination');
		var nextPagination = nextFeed.querySelector('.siini-catalog-pagination');

		feed.setAttribute('data-siini-current-page', nextFeed.getAttribute('data-siini-current-page') || feed.getAttribute('data-siini-current-page') || '1');
		feed.setAttribute('data-siini-max-pages', nextFeed.getAttribute('data-siini-max-pages') || feed.getAttribute('data-siini-max-pages') || '1');
		feed.setAttribute('data-siini-next-url', nextUrl(nextFeed));

		if (pagination && nextPagination) {
			pagination.innerHTML = nextPagination.innerHTML;
			return;
		}

		if (pagination && !nextPagination) {
			pagination.innerHTML = '';
		}
	}

	function appendNextPage(feed, nextFeed) {
		var grid = productGrid(feed);
		var nextGrid = productGrid(nextFeed);
		var known = keysForGrid(grid);
		var added = 0;

		if (!grid || !nextGrid) {
			throw new Error('missing-grid');
		}

		productCards(nextGrid).forEach(function (card) {
			var key = cardKey(card);
			if (key && known[key]) {
				return;
			}

			if (key) {
				known[key] = true;
			}

			setImagesLazy(card);
			grid.appendChild(card);
			added++;
		});

		updatePaginationFromNextFeed(feed, nextFeed);
		callProductInitializers(grid);

		return added;
	}

	function loadNext(feed) {
		var url = nextUrl(feed);

		if (feed.getAttribute('data-siini-infinite-loading') === '1' || feed.getAttribute('data-siini-infinite-status') === 'end') {
			return;
		}

		if (!url) {
			setFeedState(feed, 'end', 'Вы посмотрели все товары');
			saveFeed(feed);
			return;
		}

		feed.setAttribute('data-siini-infinite-loading', '1');
		setFeedState(feed, 'loading', 'Загружаем товары');

		window.fetch(url, {
			credentials: 'same-origin',
			headers: { 'X-Requested-With': 'XMLHttpRequest' }
		}).then(function (response) {
			if (!response.ok) {
				throw new Error('request-failed');
			}

			return response.text();
		}).then(function (html) {
			var doc = new window.DOMParser().parseFromString(html, 'text/html');
			var nextFeed = doc.querySelector('[data-siini-infinite-feed]');
			var added;

			if (!nextFeed) {
				throw new Error('missing-feed');
			}

			added = appendNextPage(feed, nextFeed);
			if (!nextUrl(feed) || added < 1) {
				setFeedState(feed, 'end', 'Вы посмотрели все товары');
			} else {
				setFeedState(feed, 'idle', '');
			}

			saveFeed(feed);
		}).catch(function () {
			setFeedState(feed, 'error', 'Не удалось загрузить товары');
		}).finally(function () {
			feed.removeAttribute('data-siini-infinite-loading');
			});
	}

	function sentinelIsNear(sentinel) {
		var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
		var passedTolerance = Math.max(640, viewportHeight * 0.75);
		var rect = sentinel.getBoundingClientRect();

		return rect.top <= viewportHeight + 360 && rect.bottom >= -passedTolerance;
	}

	function initFeed(feed) {
		var sentinel = feed.querySelector('[data-siini-infinite-sentinel]');
		var retry = feed.querySelector('[data-siini-infinite-retry]');
		var pagination = feed.querySelector('.siini-catalog-pagination');
		var scrollCheckQueued = false;
		var observer;
		var requestScrollCheck;

		if (!sentinel || feed.getAttribute('data-siini-infinite-ready') === '1' || !('fetch' in window) || !('DOMParser' in window) || !('IntersectionObserver' in window)) {
			return;
		}

		feed.setAttribute('data-siini-infinite-ready', '1');
		feed.classList.add('is-infinite-ready');

